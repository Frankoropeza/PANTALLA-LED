---
// ProcesoIndex.astro — Proceso de trabajo de PantallaLED
// Grid de 2 columnas: 5 pasos en tarjetas, el último ocupa la fila completa

import SectionHeaderDuo from '../ui/SectionHeaderDuo.astro'

const pasos = [
  {
    num: '01',
    title: 'Consulta y diagnóstico',
    desc: 'Nos cuentas tu proyecto: espacio, objetivo, presupuesto y cronograma. Evaluamos de forma gratuita el tipo de pantalla, brillo y resolución que mejor se adapta.',
    meta: 'Gratuito · Mismo día',
  },
  {
    num: '02',
    title: 'Propuesta técnica',
    desc: 'Preparamos una cotización detallada con especificaciones técnicas, planos de instalación, cronograma y condiciones de garantía. Sin costos ocultos.',
    meta: 'Respuesta en 24–48 h',
  },
  {
    num: '03',
    title: 'Fabricación y logística',
    desc: 'Gestionamos la producción con el fabricante o surtimos desde stock. Coordinamos el traslado para cumplir los tiempos acordados en tu proyecto.',
    meta: 'Stock o 1–3 semanas',
  },
  {
    num: '04',
    title: 'Instalación y puesta en marcha',
    desc: 'Nuestros técnicos realizan el montaje estructural, cableado y calibración. Configuramos el sistema de control y validamos colores, brillo y uniformidad.',
    meta: '1–4 días según formato',
  },
  {
    num: '05',
    title: 'Capacitación y soporte',
    desc: 'Capacitamos a tu equipo para operar el software de contenido. Dejamos todo documentado y activamos el plan de mantenimiento preventivo.',
    meta: 'Incluido · Soporte 24/7',
  },
]
---

<section class="section section--dark proceso-section" id="proceso" aria-labelledby="proceso-heading">
  <div class="container">

    <SectionHeaderDuo
      id="proceso-heading"
      eyebrow="Cómo trabajamos"
      title="Un proceso claro de principio a <span>fin</span>"
      desc="Cinco etapas documentadas, un solo proveedor responsable de todo el proyecto."
      body1="Cada instalación de pantalla LED sigue una metodología probada en más de 500 proyectos: diagnóstico técnico gratuito, propuesta con especificaciones y cronograma cerrado, fabricación o surtido desde stock, instalación certificada bajo norma y capacitación de tu equipo."
      body2="Sin sorpresas ni costos ocultos: sabes qué recibes, cuándo se entrega y quién responde después de la venta. Al terminar activamos el plan de mantenimiento preventivo y dejas de depender de terceros para operar tu pantalla."
    />

    <ol class="proceso-grid">
      {pasos.map((paso) => (
        <li class="proceso-paso">
          <div class="proceso-paso__top">
            <span class="proceso-paso__num" aria-hidden="true">{paso.num}</span>
            <span class="proceso-paso__meta">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"/>
                <polyline points="12 6 12 12 16 14"/>
              </svg>
              {paso.meta}
            </span>
          </div>
          <h3 class="proceso-paso__title">{paso.title}</h3>
          <p class="proceso-paso__desc">{paso.desc}</p>
        </li>
      ))}
    </ol>

  </div>
</section>

<style>
  /* El fondo lo aporta .section--dark (sistema global) */

  /* ─── Grid 2 columnas ─── */
  .proceso-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
    counter-reset: paso;
  }

  /* Con 5 pasos, el último cierra ocupando la fila completa */
  .proceso-paso:last-child:nth-child(odd) {
    grid-column: 1 / -1;
  }

  /* ─── Tarjeta de paso ─── */
  .proceso-paso {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    overflow: hidden;
    transition: border-color .2s var(--ease), box-shadow .2s var(--ease), transform .2s var(--ease);
  }
  .proceso-paso:hover {
    border-color: rgba(var(--c-primary-rgb), 0.4);
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.35), 0 0 20px rgba(var(--c-primary-rgb), 0.1);
    transform: translateY(-3px);
  }

  /* ─── Fila superior: número + tiempo ─── */
  .proceso-paso__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.25rem;
  }

  .proceso-paso__num {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--c-primary-light);
    border: 2px solid var(--c-primary);
    font-size: 0.75rem;
    font-weight: var(--weight-black);
    color: var(--c-primary);
    letter-spacing: 0.05em;
    flex-shrink: 0;
    transition: background .2s var(--ease), color .2s var(--ease);
  }
  .proceso-paso:hover .proceso-paso__num {
    background: var(--c-primary);
    color: var(--c-white);
  }

  .proceso-paso__meta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--c-muted);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-full);
    padding: 0.3rem 0.7rem;
    white-space: nowrap;
  }
  .proceso-paso__meta svg { color: var(--c-primary); flex-shrink: 0; }

  /* ─── Contenido ─── */
  .proceso-paso__title {
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--c-ink);
    line-height: 1.25;
    letter-spacing: -0.015em;
  }

  .proceso-paso__desc {
    font-size: 0.9rem;
    color: var(--c-muted);
    line-height: 1.7;
  }

  /* El último paso (fila completa) respira más a lo ancho */
  .proceso-paso:last-child:nth-child(odd) .proceso-paso__desc {
    max-width: 72ch;
  }

  /* ─── Responsive ─── */
  @media (max-width: 768px) {
    .proceso-grid { grid-template-columns: 1fr; gap: 1rem; }
    .proceso-paso { padding: 1.25rem; }
  }

  @media (max-width: 640px) {
    .proceso-paso__num { width: 38px; height: 38px; font-size: 0.6875rem; }
    .proceso-paso__meta { font-size: 0.625rem; padding: 0.25rem 0.6rem; }
  }
</style>

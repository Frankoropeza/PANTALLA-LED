---
// CTAFinalIndex.astro — Llamada a la acción final del index
// Barra CTA con glow, headline y dos botones

import { waUrl, WA_MESSAGES, CONTACT } from '../../config/site'
import IconWhatsApp from '../ui/icons/IconWhatsApp.astro'
import IconPhone from '../ui/icons/IconPhone.astro'
---

<section class="cta-final" aria-labelledby="cta-final-heading">
  <!-- Fondo con glow -->
  <div class="cta-final__bg" aria-hidden="true">
    <div class="cta-final__glow"></div>
  </div>

  <div class="container cta-final__inner">
    <div class="cta-final__text">
      <p class="cta-final__eyebrow">¿Listo para tu proyecto LED?</p>
      <h2 id="cta-final-heading" class="cta-final__title">
        Ilumina tu negocio con<br/>
        <span class="cta-final__accent">tecnología LED de primer nivel</span>
      </h2>
      <p class="cta-final__desc">
        Cotización sin costo. Respuesta en menos de 2 horas. Instalación certificada en toda la República.
      </p>
    </div>

    <div class="cta-final__actions">
      <a
        href={waUrl(WA_MESSAGES.cotizacion)}
        class="btn btn--whatsapp btn--lg cta-final__btn-primary"
        target="_blank"
        rel="noopener noreferrer"
      >
        <IconWhatsApp size={20} />
        Solicitar cotización gratis
      </a>
      <a href={`tel:${CONTACT.phoneRaw}`} class="btn btn--outline btn--lg cta-final__btn-secondary">
        <IconPhone size={18} />
        {CONTACT.phone}
      </a>
    </div>

  </div>
</section>

<style>
  .cta-final {
    position: relative;
    background: var(--c-bg);
    border-top: 1px solid var(--c-border);
    padding-block: clamp(4rem, 8vw, 6rem);
    overflow: hidden;
  }

  .cta-final__bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .cta-final__glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 700px;
    height: 300px;
    background: radial-gradient(ellipse, rgba(var(--c-primary-rgb), 0.15) 0%, transparent 70%);
    filter: blur(40px);
  }

  .cta-final__inner {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 3rem;
  }

  .cta-final__text { flex: 1; }

  .cta-final__eyebrow {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--c-primary);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 0.875rem;
  }

  .cta-final__title {
    font-size: clamp(1.75rem, 3vw, 2.625rem);
    font-weight: 800;
    color: var(--c-ink);
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin-bottom: 0.875rem;
  }

  .cta-final__accent { color: var(--c-primary); }

  .cta-final__desc {
    font-size: 1rem;
    color: var(--c-muted);
    line-height: 1.6;
  }

  /* Botones: usan .btn--whatsapp / .btn--outline (sistema global) */
  .cta-final__actions {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    flex-shrink: 0;
    min-width: 260px;
  }

  .cta-final__btn-primary,
  .cta-final__btn-secondary {
    justify-content: center;
  }

  @media (max-width: 900px) {
    .cta-final__inner { flex-direction: column; text-align: center; }
    .cta-final__actions { width: 100%; min-width: auto; }
  }
</style>

---
/**
 * servicios.astro — Servicios de PantallaLED (L2)
 * Orquestador: PageHero + detalle de los 8 servicios (anclas públicas) +
 * proceso + CTA final. Datos: config/servicios.ts (fuente única).
 * Schemas: BreadcrumbList + ItemList de Service.
 */

import Base from '../layouts/Base.astro'
import PageHero from '../components/sections/PageHero.astro'
import SectionHeaderDuo from '../components/ui/SectionHeaderDuo.astro'
import ProcesoIndex from '../components/sections/ProcesoIndex.astro'
import CTAFinalIndex from '../components/sections/CTAFinalIndex.astro'
import IconCheck from '../components/ui/icons/IconCheck.astro'
import IconWhatsApp from '../components/ui/icons/IconWhatsApp.astro'

import { SITE, waUrl, WA_MESSAGES } from '../config/site'
import { SERVICIOS } from '../config/servicios'

// ─── Meta SEO ─────────────────────────────────────────────────────────────────
const title = 'Servicios de Pantallas LED | Venta, Renta, Instalación y Mantenimiento — PantallaLED'
const description =
  'Solución integral de pantallas LED en México: venta directa de fábrica, renta para eventos, instalación certificada bajo norma, mantenimiento 24/7, asesoría técnica gratuita y gestión de contenido. Un solo proveedor para todo el ciclo de vida de tu pantalla.'
const canonical = `${SITE.url}/servicios/`

// ─── JSON-LD: BreadcrumbList ──────────────────────────────────────────────────
const schemaBreadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Servicios', item: canonical },
  ],
}

// ─── JSON-LD: ItemList de servicios ───────────────────────────────────────────
const schemaServicios = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Servicios de Pantallas LED',
  numberOfItems: SERVICIOS.length,
  itemListElement: SERVICIOS.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Service',
      name: s.title,
      description: s.desc,
      url: `${canonical}#${s.id}`,
      provider: { '@id': `${SITE.url}/#organization` },
      areaServed: { '@type': 'Country', name: 'México' },
    },
  })),
}
---

<Base {title} {description} {canonical}>

  <!-- ─── Hero L2 ──────────────────────────────────────────────────────── -->
  <PageHero
    eyebrow="Solución integral"
    title="Servicios de <span>Pantallas LED</span>"
    desc="Un solo proveedor para todo el ciclo de vida de tu pantalla: desde la asesoría y la venta directa de fábrica, hasta la instalación certificada, el contenido y el mantenimiento 24/7. Operación propia en CDMX y cobertura en toda la República Mexicana."
    crumbs={[
      { label: 'Inicio', href: '/' },
      { label: 'Servicios' },
    ]}
  />

  <!-- ─── Detalle de servicios ─────────────────────────────────────────── -->
  <section class="section section--surface" aria-labelledby="servicios-detalle-heading">
    <div class="container">

      <SectionHeaderDuo
        id="servicios-detalle-heading"
        eyebrow="Qué hacemos"
        title="Ocho servicios, un solo <span>responsable</span>"
        desc="Cada servicio incluye alcances documentados, tiempos comprometidos y un técnico asignado."
        body1="Comprar una pantalla LED es solo el primer paso: el valor real está en que encienda todos los días. Por eso integramos venta, instalación bajo norma NOM, gestión de contenido y mantenimiento preventivo en un mismo equipo técnico, sin subcontrataciones improvisadas."
        body2="Trabajas con un solo proveedor responsable de extremo a extremo: cotización el mismo día, factura electrónica, garantía de fábrica de 2 años y soporte 24/7 con refacciones originales en stock dentro de México."
      />

      <div class="servicios-detalle-grid">
        {SERVICIOS.map((svc) => (
          <article class="sdet" id={svc.id}>
            <div class="sdet__top">
              <span class="sdet__num" aria-hidden="true">{svc.num}</span>
              <h3 class="sdet__title">{svc.title}</h3>
            </div>
            <p class="sdet__desc">{svc.desc}</p>
            <ul class="sdet__features">
              {svc.features.map((f) => (
                <li class="sdet__feature">
                  <IconCheck size={15} strokeWidth={2.5} />
                  {f}
                </li>
              ))}
            </ul>
            <div class="sdet__footer">
              <a
                href={waUrl(`${WA_MESSAGES.servicios} — ${svc.title}`)}
                class="link-arrow"
                target="_blank"
                rel="noopener noreferrer"
              >
                <IconWhatsApp size={14} />
                Cotizar este servicio
              </a>
            </div>
          </article>
        ))}
      </div>

    </div>
  </section>

  <!-- ─── Secciones compartidas ────────────────────────────────────────── -->
  <ProcesoIndex />
  <CTAFinalIndex />

  <!-- ─── JSON-LD ──────────────────────────────────────────────────────── -->
  <script type="application/ld+json" set:html={JSON.stringify(schemaBreadcrumb)} />
  <script type="application/ld+json" set:html={JSON.stringify(schemaServicios)} />

</Base>

<style>
  /* ─── Grid de servicios a detalle ─── */
  .servicios-detalle-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  /* ─── Card de servicio — receta canónica de Tarjetas ─── */
  .sdet {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    transition: border-color .2s var(--ease), box-shadow .2s var(--ease), transform .2s var(--ease);
  }
  .sdet:hover {
    border-color: rgba(var(--c-primary-rgb), 0.4);
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.35), 0 0 20px rgba(var(--c-primary-rgb), 0.1);
    transform: translateY(-3px);
  }

  .sdet__top {
    display: flex;
    align-items: center;
    gap: 0.875rem;
  }
  .sdet__num {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--c-primary-light);
    border: 2px solid var(--c-primary);
    font-size: 0.75rem;
    font-weight: var(--weight-black);
    color: var(--c-primary);
    letter-spacing: 0.05em;
    flex-shrink: 0;
    transition: background .2s var(--ease), color .2s var(--ease);
  }
  .sdet:hover .sdet__num {
    background: var(--c-primary);
    color: var(--c-white);
  }
  .sdet__title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--c-ink);
    line-height: 1.25;
    letter-spacing: -0.015em;
  }

  .sdet__desc {
    font-size: 0.9rem;
    color: var(--c-muted);
    line-height: 1.7;
  }

  .sdet__features {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 0.25rem;
    flex: 1;
  }
  .sdet__feature {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.8438rem;
    color: var(--c-ink-2);
    line-height: 1.55;
  }
  .sdet__feature svg {
    color: var(--c-success);
    flex-shrink: 0;
    margin-top: 0.2rem;
  }

  .sdet__footer {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--c-border);
  }
  .sdet__footer :global(.link-arrow) { color: var(--color-whatsapp); }
  .sdet__footer :global(.link-arrow svg) { transform: none; }

  /* ─── Responsive ─── */
  @media (max-width: 900px) {
    .servicios-detalle-grid { grid-template-columns: 1fr; gap: 1rem; }
  }
  @media (max-width: 640px) {
    .sdet { padding: 1.25rem; }
    .sdet__num { width: 38px; height: 38px; font-size: 0.6875rem; }
  }
</style>

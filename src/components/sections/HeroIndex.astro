---
// HeroIndex.astro — Hero principal
// Dos columnas: título grande (izq) · párrafos + CTAs (der)

import { waUrl, WA_MESSAGES } from '../../config/site'
import { url } from '../../utils/url'
import IconArrowRight from '../ui/icons/IconArrowRight.astro'
import IconWhatsApp from '../ui/icons/IconWhatsApp.astro'
import IconCheck from '../ui/icons/IconCheck.astro'

const trustItems = [
  'Garantía 2 años',
  'Entrega en todo México',
  'Instalación certificada',
  'Soporte 24/7',
]
---

<section class="hero" aria-labelledby="hero-heading">

  <!-- Fondo decorativo -->
  <div class="hero__bg" aria-hidden="true">
    <div class="hero__grid"></div>
    <div class="hero__glow hero__glow--tl"></div>
    <div class="hero__glow hero__glow--br"></div>
  </div>

  <div class="container hero__inner">

    <!-- ══ Columna 1 — Título ══ -->
    <div class="hero__col hero__col--title">

      <p class="hero__eyebrow">
        <span class="hero__eyebrow-dot" aria-hidden="true"></span>
        Proveedor directo · Sin intermediarios
      </p>

      <h1 id="hero-heading" class="hero__title">
        Pantallas<br/>
        LED de<br/>
        Alta<br/>
        <span class="hero__title-accent">Resolución</span>
      </h1>

      <div class="hero__stats" aria-label="Métricas del negocio">
        <div class="hero__stat">
          <strong class="hero__stat-val">+500</strong>
          <span class="hero__stat-lbl">Instalaciones</span>
        </div>
        <div class="hero__stat-sep" aria-hidden="true"></div>
        <div class="hero__stat">
          <strong class="hero__stat-val">10+</strong>
          <span class="hero__stat-lbl">Años de exp.</span>
        </div>
        <div class="hero__stat-sep" aria-hidden="true"></div>
        <div class="hero__stat">
          <strong class="hero__stat-val">2</strong>
          <span class="hero__stat-lbl">Años garantía</span>
        </div>
      </div>

    </div>

    <!-- Separador vertical -->
    <div class="hero__divider" aria-hidden="true"></div>

    <!-- ══ Columna 2 — Cuerpo ══ -->
    <div class="hero__col hero__col--body">

      <span class="hero__kicker">Para México · Tecnología SMD &amp; COB</span>

      <p class="hero__p">
        Somos proveedores directos de pantallas LED de alta resolución para
        publicidad exterior, interiores y eventos. Equipos IP65 con hasta
        10,000 nits para exteriores e interiores Ultra HD desde P2 — sin
        intermediarios, con cotización gratuita el mismo día en toda la
        República Mexicana.
      </p>

      <p class="hero__p">
        Instalación certificada por técnicos especializados con más de 10 años
        de experiencia. Garantía real de fábrica de 2 años, soporte técnico
        24/7 y respuesta garantizada en menos de 2 horas. Un solo proveedor
        para todo el ciclo de vida de tu pantalla LED.
      </p>

      <div class="hero__ctas">
        <a href={url('/productos/')} class="btn btn--primary btn--lg hero__btn-primary">
          Ver catálogo LED
          <IconArrowRight size={16} />
        </a>
        <a
          href={waUrl(WA_MESSAGES.cotizacion)}
          class="btn btn--whatsapp-soft btn--lg hero__btn-wa"
          target="_blank"
          rel="noopener noreferrer"
        >
          <IconWhatsApp size={18} />
          Cotizar por WhatsApp
        </a>
      </div>

      <div class="hero__trust">
        {trustItems.map((item) => (
          <span class="hero__trust-item">
            <IconCheck size={12} />
            {item}
          </span>
        ))}
      </div>

    </div>

  </div>
</section>

<style>
  /* ─── Sección ─────────────────────────────────────── */
  .hero {
    position: relative;
    min-height: 88vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    padding-block: clamp(5rem, 8vw, 7rem);
  }

  /* ─── Fondo ─────────────────────────────────────────── */
  .hero__bg { position: absolute; inset: 0; pointer-events: none; }

  .hero__grid {
    position: absolute; inset: 0;
    opacity: 0.035;
    background-image:
      linear-gradient(rgba(var(--c-primary-rgb), 1) 1px, transparent 1px),
      linear-gradient(90deg, rgba(var(--c-primary-rgb), 1) 1px, transparent 1px);
    background-size: 72px 72px;
  }

  .hero__glow { position: absolute; border-radius: 50%; filter: blur(140px); }
  .hero__glow--tl {
    top: -20%; left: -8%;
    width: 55vw; height: 65vh;
    background: radial-gradient(ellipse, rgba(var(--c-primary-rgb), 0.22) 0%, transparent 68%);
  }
  .hero__glow--br {
    bottom: -20%; right: 5%;
    width: 40vw; height: 50vh;
    background: radial-gradient(ellipse, rgba(0,60,180,0.15) 0%, transparent 70%);
  }

  /* ─── Grid principal ─────────────────────────────── */
  .hero__inner {
    position: relative; z-index: 1;
    display: grid;
    grid-template-columns: 1fr 1px 1fr;
    column-gap: clamp(2.5rem, 4.5vw, 4.5rem);
    align-items: center;
    width: 100%;
  }

  /* ─── Separador vertical ──────────────────────────── */
  .hero__divider {
    width: 1px;
    align-self: stretch;
    min-height: 420px;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      var(--c-border) 18%,
      var(--c-border-2) 50%,
      var(--c-border) 82%,
      transparent 100%
    );
  }

  /* ─── Columnas ────────────────────────────────────── */
  .hero__col {
    display: flex;
    flex-direction: column;
  }
  .hero__col--title { gap: 2.25rem; }
  .hero__col--body  { gap: 1.625rem; }

  /* ─── Eyebrow ─────────────────────────────────────── */
  .hero__eyebrow {
    display: inline-flex; align-items: center; gap: 0.5rem;
    background: rgba(var(--c-primary-rgb), 0.08);
    border: 1px solid rgba(var(--c-primary-rgb), 0.25);
    color: rgba(140,195,255,0.9);
    font-size: 0.8rem; font-weight: 500;
    padding: 0.4rem 1rem; border-radius: 100px;
    letter-spacing: 0.02em; width: fit-content;
  }
  .hero__eyebrow-dot {
    width: 7px; height: 7px; background: var(--c-primary);
    border-radius: 50%; flex-shrink: 0;
    animation: pulse 2.2s ease-in-out infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%       { opacity: .4; transform: scale(.7); }
  }

  /* ─── Título ──────────────────────────────────────── */
  .hero__title {
    font-size: clamp(2.875rem, 5.5vw, 5.5rem);
    font-weight: 800;
    color: var(--c-ink);
    line-height: 1.02;
    letter-spacing: -0.035em;
  }
  .hero__title-accent {
    background: linear-gradient(130deg, #72c6ff 0%, #1a7fe8 45%, #0050b8 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* ─── Stats ───────────────────────────────────────── */
  .hero__stats {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--c-border);
  }
  .hero__stat {
    display: flex; flex-direction: column; gap: 0.2rem;
  }
  .hero__stat-val {
    font-size: clamp(1.375rem, 2vw, 1.75rem);
    font-weight: 800; color: var(--c-ink);
    line-height: 1; letter-spacing: -0.02em;
  }
  .hero__stat-lbl {
    font-size: 0.725rem; color: var(--c-muted);
    font-weight: 500; letter-spacing: 0.025em;
  }
  .hero__stat-sep {
    width: 1px; height: 36px;
    background: var(--c-border); flex-shrink: 0;
  }

  /* ─── Kicker ──────────────────────────────────────── */
  .hero__kicker {
    font-size: 0.75rem; font-weight: 600;
    color: var(--c-primary);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  /* ─── Párrafos ────────────────────────────────────── */
  .hero__p {
    font-size: clamp(0.9375rem, 1.1vw, 1.0625rem);
    color: var(--c-ink-2);
    line-height: 1.85;
  }

  /* ─── CTAs ────────────────────────────────────────── */
  /* Los botones usan el sistema global (.btn--primary / .btn--whatsapp-soft) */
  .hero__ctas {
    display: flex; gap: 0.875rem; flex-wrap: wrap;
    padding-top: 0.375rem;
  }

  /* ─── Trust ───────────────────────────────────────── */
  .hero__trust {
    display: flex; flex-wrap: wrap; gap: 1.125rem;
    padding-top: 0.25rem;
    border-top: 1px solid rgba(30,45,80,0.6);
  }
  .hero__trust-item {
    display: flex; align-items: center; gap: 0.375rem;
    font-size: 0.8125rem; color: var(--c-muted); font-weight: 500;
  }
  .hero__trust-item svg { color: var(--c-primary); flex-shrink: 0; }

  /* ─── Responsive ──────────────────────────────────── */
  @media (max-width: 1024px) {
    .hero__inner {
      grid-template-columns: 1fr;
      column-gap: 0;
      row-gap: 3rem;
    }
    .hero__divider { display: none; }
    .hero__col--title { align-items: center; text-align: center; }
    .hero__col--body  { align-items: center; text-align: center; }
    .hero__stats      { justify-content: center; }
    .hero__ctas       { justify-content: center; }
    .hero__trust      { justify-content: center; }
    .hero__p          { max-width: 58ch; }
  }

  @media (max-width: 640px) {
    .hero {
      min-height: auto;
      padding-block: 3.5rem 3rem;
    }
    .hero__title { font-size: clamp(2.5rem, 10vw, 3.25rem); }
    .hero__ctas {
      flex-direction: column;
      width: 100%;
      gap: 0.75rem;
    }
    .hero__btn-primary,
    .hero__btn-wa {
      width: 100%;
      justify-content: center;
      padding: 1rem 1.25rem;
    }
    .hero__stats { gap: 1.125rem; }
    .hero__stat-val { font-size: 1.25rem; }
    .hero__p { font-size: 0.9375rem; line-height: 1.8; }
  }

  @media (max-width: 380px) {
    .hero__title { font-size: 2.25rem; }
    .hero__eyebrow { font-size: 0.75rem; padding: 0.35rem 0.85rem; }
  }
</style>

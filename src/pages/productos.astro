---
/**
 * productos.astro — Catálogo de pantallas LED (L2)
 * Orquestador: PageHero + CtaBar + catálogo (CategoryCard) +
 * modelos destacados (colección markdown) + especificaciones + CTA final.
 * Schemas: BreadcrumbList + ItemList.
 */

import { getCollection } from 'astro:content'

import Base from '../layouts/Base.astro'
import PageHero from '../components/sections/PageHero.astro'
import QuickNav from '../components/sections/QuickNav.astro'
import TrustStrip from '../components/sections/TrustStrip.astro'
import CategoriaSpotlight from '../components/sections/CategoriaSpotlight.astro'
import SectionHeaderDuo from '../components/ui/SectionHeaderDuo.astro'
import CategoryCard from '../components/ui/CategoryCard.astro'
import EspecificacionesIndex from '../components/sections/EspecificacionesIndex.astro'
import CTAFinalIndex from '../components/sections/CTAFinalIndex.astro'
import IconArrowRight from '../components/ui/icons/IconArrowRight.astro'

import { SITE, WA_MESSAGES } from '../config/site'
import { CATEGORIAS } from '../config/categorias'
import { url } from '../utils/url'

// ─── Navegación rápida: una pill por categoría + secciones de la página ──────
const quickNavEnlaces = [
  ...CATEGORIAS.map((cat) => ({
    label: cat.title.replace('Pantallas ', ''),
    href: `#${cat.slug}-detalle`,
  })),
  { label: 'Fichas técnicas', href: '#modelos' },
  { label: 'Guía de pixel', href: '#especificaciones' },
  { label: 'Asesoría gratuita', href: '/contacto/' },
]

// ─── Franja de confianza ──────────────────────────────────────────────────────
const trustItems = [
  {
    title: 'Equipos originales',
    desc: 'Módulos SMD y COB de fabricantes certificados, con número de serie y garantía de fábrica de 2 años.',
  },
  {
    title: 'Documentación completa',
    desc: 'Ficha técnica, factura electrónica y garantía por escrito en cada entrega — listo para tu contabilidad.',
  },
  {
    title: 'Stock en México',
    desc: 'Configuraciones más demandadas listas para entrega en 24–48 h en CDMX y envío a todo el país.',
  },
  {
    title: 'Precio directo de fábrica',
    desc: 'Sin intermediarios: mejor costo por m² y esquemas preferenciales para proyectos por volumen.',
  },
]

// ─── Modelos destacados (colección markdown) ─────────────────────────────────
const modelos = (await getCollection('productos')).sort(
  (a, b) => a.data.order - b.data.order
)

// ─── Meta SEO ─────────────────────────────────────────────────────────────────
const title = 'Catálogo de Pantallas LED | Venta Directa de Fábrica — PantallaLED'
const description =
  'Catálogo completo de pantallas LED en México: exteriores IP65, interiores Ultra HD, flexibles, para eventos, de piso y transparentes. Paso de pixel P2 a P10, garantía de 2 años y cotización el mismo día.'
const canonical = `${SITE.url}/productos/`

// ─── JSON-LD: BreadcrumbList ──────────────────────────────────────────────────
const schemaBreadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Productos', item: canonical },
  ],
}

// ─── JSON-LD: ItemList (categorías del catálogo) ──────────────────────────────
const schemaItemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Catálogo de Pantallas LED',
  numberOfItems: CATEGORIAS.length,
  itemListElement: CATEGORIAS.map((cat, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: cat.title,
    url: `${SITE.url}${cat.href}`,
  })),
}
---

<Base {title} {description} {canonical}>

  <!-- ─── Hero L2 editorial ────────────────────────────────────────────── -->
  <PageHero
    eyebrow="Catálogo 2026 · Proveedor directo"
    title="Catálogo de<br/>Pantallas <span>LED</span>"
    kicker="Tecnología SMD & COB · P2 a P10"
    desc="Seis líneas de producto que cubren todo el espectro: espectaculares exteriores IP65 de hasta 10,000 nits, interiores Ultra HD con color de nivel broadcast, módulos flexibles para arquitectura creativa, pantallas de piso, transparentes y módulos de renta para eventos."
    body2="Venta directa de fábrica sin intermediarios: mejor precio por metro cuadrado, garantía real de 2 años, refacciones en stock e instalación certificada en toda la República Mexicana."
    crumbs={[
      { label: 'Inicio', href: '/' },
      { label: 'Productos' },
    ]}
  />

  <QuickNav
    label="Explora el catálogo"
    enlaces={quickNavEnlaces}
    ctaLabel="Cotizar catálogo"
    ctaMessage={WA_MESSAGES.productos}
  />

  <TrustStrip items={trustItems} />

  <!-- ─── Catálogo por categoría ───────────────────────────────────────── -->
  <section class="section section--surface" id="catalogo" aria-labelledby="catalogo-heading">
    <div class="container">

      <SectionHeaderDuo
        id="catalogo-heading"
        eyebrow="Líneas de producto"
        title="Encuentra la pantalla para <span>tu proyecto</span>"
        desc="Cada categoría incluye múltiples pasos de pixel y formatos configurables a medida."
        body1="Las pantallas exteriores dominan espectaculares, fachadas y vías de alto tráfico con hasta 10,000 nits y certificación IP65. Las interiores Ultra HD (P2–P4) entregan color de nivel broadcast para retail, lobbies corporativos y centros comerciales."
        body2="Para proyectos especiales: módulos flexibles que se curvan sobre cualquier geometría, pantallas de piso de alta resistencia, transparentes para vitrinas y módulos de renta para escenarios y eventos. Todas las líneas con refacciones en stock y soporte 24/7."
      />

      <div class="catalogo-grid">
        {CATEGORIAS.map((cat) => (
          <CategoryCard categoria={cat} />
        ))}
      </div>

    </div>
  </section>

  <!-- ─── Spotlight por categoría (detalle SEO, fondos alternados) ─────── -->
  {CATEGORIAS.map((cat, i) => (
    <CategoriaSpotlight categoria={cat} index={i} />
  ))}

  <!-- ─── Modelos destacados (markdown) ────────────────────────────────── -->
  {modelos.length > 0 && (
    <section class="section section--dark" id="modelos" aria-labelledby="modelos-heading">
      <div class="container">

        <SectionHeaderDuo
          id="modelos-heading"
          eyebrow="Fichas técnicas"
          title="Modelos con <span>especificaciones completas</span>"
          desc="Documentación técnica detallada: paso de pixel, luminosidad, ángulos de visión y aplicaciones."
          body1="Cada ficha incluye tabla de especificaciones, casos de uso recomendados y los rangos de brillo certificados por el fabricante — la información que necesitas para comparar opciones antes de cotizar."
          body2="¿No encuentras el modelo exacto? Configuramos cualquier medida y paso de pixel sobre pedido. Nuestros ingenieros te ayudan a definir la ficha técnica ideal para tu espacio sin costo."
        />

        <div class="modelos-grid">
          {modelos.map((m) => (
            <article class="pcard">
              <div class="pcard__head">
                <span class="pcard__tipo">{m.data.tipo}</span>
                {m.data.destacado && <span class="pcard__destacado">Más solicitado</span>}
              </div>
              <h3 class="pcard__title">{m.data.title}</h3>
              <p class="pcard__desc">{m.data.description}</p>
              <dl class="pcard__specs">
                <div class="pcard__spec">
                  <dt>Paso de pixel</dt>
                  <dd>{m.data.pixelPitch}</dd>
                </div>
                {m.data.luminosidad && (
                  <div class="pcard__spec">
                    <dt>Luminosidad</dt>
                    <dd>{m.data.luminosidad}</dd>
                  </div>
                )}
              </dl>
              <a href={url(`/productos/${m.id}/`)} class="pcard__footer" aria-label={`Ver ficha técnica de ${m.data.title}`}>
                <span class="pcard__footer-label">Ver ficha técnica</span>
                <span class="pcard__footer-arrow" aria-hidden="true">
                  <IconArrowRight size={14} />
                </span>
              </a>
            </article>
          ))}
        </div>

      </div>
    </section>
  )}

  <!-- ─── Secciones compartidas con el index ───────────────────────────── -->
  <EspecificacionesIndex />
  <CTAFinalIndex />

  <!-- ─── JSON-LD ──────────────────────────────────────────────────────── -->
  <script type="application/ld+json" set:html={JSON.stringify(schemaBreadcrumb)} />
  <script type="application/ld+json" set:html={JSON.stringify(schemaItemList)} />

</Base>

<style>
  /* ─── Grid de modelos ─── */
  .modelos-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  /* ─── Card de modelo (ficha técnica) — receta canónica de Tarjetas ─── */
  .pcard {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    transition: border-color .2s var(--ease), box-shadow .2s var(--ease), transform .2s var(--ease);
  }
  .pcard:hover {
    border-color: rgba(var(--c-primary-rgb), 0.4);
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.35), 0 0 20px rgba(var(--c-primary-rgb), 0.1);
    transform: translateY(-3px);
  }

  .pcard__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .pcard__tipo {
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-primary-soft);
    background: rgba(var(--c-primary-rgb), 0.15);
    border: 1px solid rgba(var(--c-primary-rgb), 0.3);
    border-radius: var(--radius-full);
    padding: 0.3rem 0.7rem;
  }
  .pcard__destacado {
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-success);
    background: rgba(var(--c-success-rgb), 0.1);
    border: 1px solid rgba(var(--c-success-rgb), 0.25);
    border-radius: var(--radius-full);
    padding: 0.3rem 0.7rem;
  }

  .pcard__title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--c-ink);
    line-height: 1.25;
    letter-spacing: -0.02em;
    transition: color .2s var(--ease);
  }
  .pcard:hover .pcard__title { color: var(--c-primary-soft); }

  .pcard__desc {
    font-size: 0.875rem;
    color: var(--c-muted);
    line-height: 1.65;
    flex: 1;
  }

  /* Specs en filas dt/dd */
  .pcard__specs {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    margin-top: 0.375rem;
  }
  .pcard__spec {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.8125rem;
    padding: 0.45rem 0;
    border-bottom: 1px dashed var(--c-border);
  }
  .pcard__spec dt { color: var(--c-muted); }
  .pcard__spec dd { color: var(--c-ink); font-weight: 600; text-align: right; }

  /* Footer clickeable — mismo patrón que CategoryCard */
  .pcard__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--c-border);
  }
  .pcard__footer::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .pcard__footer-label {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--c-primary);
  }
  .pcard__footer-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 1px solid var(--c-border);
    color: var(--c-muted);
    transition: border-color .2s var(--ease), color .2s var(--ease),
                background .2s var(--ease), transform .2s var(--ease);
  }
  .pcard:hover .pcard__footer-arrow {
    border-color: var(--c-primary);
    background: var(--c-primary);
    color: var(--c-white);
    transform: translateX(3px);
  }

  /* ─── Responsive ─── */
  @media (max-width: 1024px) {
    .modelos-grid { grid-template-columns: repeat(2, 1fr); gap: 1.25rem; }
  }
  @media (max-width: 640px) {
    .modelos-grid { grid-template-columns: 1fr; gap: 1rem; }
  }
</style>

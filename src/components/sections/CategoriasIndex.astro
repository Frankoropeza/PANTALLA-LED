---
// CategoriasIndex.astro — Grid de tipos de pantallas LED
// Tarjetas con visuales CSS temáticos por categoría

import SectionHeader from '../ui/SectionHeader.astro'
import IconArrowRight from '../ui/icons/IconArrowRight.astro'
import { url } from '../../utils/url'

const categorias = [
  {
    slug: 'pantallas-exteriores',
    title: 'Pantallas Exteriores',
    badge: 'IP65 · Intemperie',
    desc: 'Alta luminosidad para publicidad al aire libre. Resistentes al agua, polvo y variaciones de temperatura extrema.',
    specs: ['P4', 'P5', 'P6', 'P8', 'P10'],
    href: '/productos/pantallas-exteriores/',
    visual: 'exterior',
    highlight: true,
  },
  {
    slug: 'pantallas-interiores',
    title: 'Pantallas Interiores',
    badge: 'Ultra HD · 4K',
    desc: 'Resolución y colores premium para lobbies, centros comerciales, restaurantes y hoteles de primer nivel.',
    specs: ['P2', 'P2.5', 'P3', 'P4'],
    href: '/productos/pantallas-interiores/',
    visual: 'interior',
    highlight: false,
  },
  {
    slug: 'pantallas-flexibles',
    title: 'Pantallas Flexibles',
    badge: 'Curva · Creativa',
    desc: 'Módulos curvables para diseños cilíndricos, cóncavos y transparentes en arquitectura de vanguardia.',
    specs: ['Curva', 'Cilíndrica', 'Transparente'],
    href: '/productos/pantallas-flexibles/',
    visual: 'flexible',
    highlight: false,
  },
  {
    slug: 'pantallas-eventos',
    title: 'Pantallas para Eventos',
    badge: 'Renta disponible',
    desc: 'Módulos de alta resolución para escenarios, conciertos, convenciones y activaciones de marca.',
    specs: ['Backdrop', 'Escenario', 'Stage LED'],
    href: '/productos/pantallas-eventos/',
    visual: 'eventos',
    highlight: false,
  },
  {
    slug: 'pantallas-piso',
    title: 'Pantallas de Piso',
    badge: 'LED Floor',
    desc: 'Pistas de baile interactivas y pisos visuales para eventos, discotecas y shows en vivo.',
    specs: ['P3.9', 'P6.25', 'Interactivo'],
    href: '/productos/pantallas-piso/',
    visual: 'piso',
    highlight: false,
  },
  {
    slug: 'pantallas-transparentes',
    title: 'Pantallas Transparentes',
    badge: 'Glass LED',
    desc: 'Transparencia de hasta 85% para vitrinas, fachadas de vidrio y aplicaciones arquitectónicas únicas.',
    specs: ['P7.8', 'P10', 'P15.6'],
    href: '/productos/pantallas-transparentes/',
    visual: 'transparente',
    highlight: false,
  },
]
---

<section class="section section--dark categorias-section" id="productos" aria-labelledby="categorias-heading">
  <div class="container">

    <SectionHeader
      id="categorias-heading"
      eyebrow="Catálogo de Productos"
      title="Pantallas LED para <span>cada aplicación</span>"
      desc="Desde publicidad de gran formato hasta instalaciones creativas. Tecnología SMD y COB de última generación con garantía de 2 años en todos los equipos."
    />

    <div class="categorias-grid">
      {categorias.map((cat) => (
        <article class:list={['ccat', `ccat--${cat.visual}`, { 'ccat--highlight': cat.highlight }]}>

          <!-- Thumbnail visual temático -->
          <div class="ccat__thumb" aria-hidden="true">
            <div class="ccat__thumb-pixels"></div>
            <div class="ccat__thumb-glow"></div>
            <div class="ccat__thumb-icon">
              {cat.visual === 'exterior' && (
                <svg width="38" height="38" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3">
                  <rect x="2" y="3" width="20" height="13" rx="2"/>
                  <line x1="8" y1="21" x2="16" y2="21"/>
                  <line x1="12" y1="16" x2="12" y2="21"/>
                  <circle cx="12" cy="9.5" r="2.5"/>
                  <line x1="2" y1="16" x2="22" y2="16"/>
                </svg>
              )}
              {cat.visual === 'interior' && (
                <svg width="38" height="38" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3">
                  <rect x="2" y="4" width="20" height="13" rx="1"/>
                  <line x1="2" y1="9" x2="22" y2="9"/>
                  <line x1="2" y1="13" x2="22" y2="13"/>
                  <line x1="8" y1="4" x2="8" y2="17"/>
                  <line x1="14" y1="4" x2="14" y2="17"/>
                  <line x1="9" y1="20" x2="15" y2="20"/>
                  <line x1="12" y1="17" x2="12" y2="20"/>
                </svg>
              )}
              {cat.visual === 'flexible' && (
                <svg width="38" height="38" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3">
                  <path d="M3 6 C7 4 11 4 15 6 C19 8 21 8 21 8"/>
                  <path d="M3 10 C7 8 11 8 15 10 C19 12 21 12 21 12"/>
                  <path d="M3 14 C7 12 11 12 15 14 C19 16 21 16 21 16"/>
                  <path d="M3 18 C7 16 11 16 15 18 C19 20 21 20 21 20"/>
                </svg>
              )}
              {cat.visual === 'eventos' && (
                <svg width="38" height="38" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3">
                  <rect x="2" y="5" width="20" height="11" rx="1"/>
                  <line x1="5" y1="16" x2="3" y2="21"/>
                  <line x1="19" y1="16" x2="21" y2="21"/>
                  <line x1="3" y1="21" x2="21" y2="21"/>
                  <circle cx="12" cy="10.5" r="2.5"/>
                  <line x1="7" y1="5" x2="5" y2="2"/>
                  <line x1="17" y1="5" x2="19" y2="2"/>
                </svg>
              )}
              {cat.visual === 'piso' && (
                <svg width="38" height="38" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3">
                  <rect x="2" y="12" width="20" height="8" rx="1"/>
                  <line x1="8" y1="12" x2="8" y2="20"/>
                  <line x1="14" y1="12" x2="14" y2="20"/>
                  <line x1="2" y1="16" x2="22" y2="16"/>
                  <path d="M8 12 L12 6 L16 12"/>
                  <line x1="12" y1="6" x2="12" y2="3"/>
                </svg>
              )}
              {cat.visual === 'transparente' && (
                <svg width="38" height="38" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3">
                  <rect x="5" y="3" width="14" height="18" rx="1"/>
                  <line x1="5" y1="8" x2="19" y2="8"/>
                  <line x1="5" y1="13" x2="19" y2="13"/>
                  <line x1="5" y1="18" x2="19" y2="18"/>
                  <line x1="10" y1="3" x2="10" y2="21"/>
                  <line x1="15" y1="3" x2="15" y2="21"/>
                </svg>
              )}
            </div>
            <span class="ccat__thumb-badge">{cat.badge}</span>
          </div>

          <div class="ccat__body">
            <h3 class="ccat__title">{cat.title}</h3>
            <p class="ccat__desc">{cat.desc}</p>

            <div class="ccat__specs" aria-label="Variantes disponibles">
              {cat.specs.map((s) => (
                <span class="ccat__spec">{s}</span>
              ))}
            </div>

            <a href={url(cat.href)} class="link-arrow ccat__link" aria-label={`Ver modelos de ${cat.title}`}>
              Ver modelos
              <IconArrowRight size={14} />
            </a>
          </div>
        </article>
      ))}
    </div>

    <div class="categorias-footer">
      <a href={url('/productos/')} class="btn btn--outline btn--lg">
        Ver catálogo completo
        <IconArrowRight size={16} />
      </a>
    </div>

  </div>
</section>

<style>
  /* El fondo lo aporta .section--dark (sistema global) */

  .categorias-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  @media (min-width: 1440px) {
    .categorias-grid { grid-template-columns: repeat(6, 1fr); gap: 1rem; }
    .ccat__body { padding: 1rem; }
  }

  /* ─── Tarjeta base ─── */
  .ccat {
    display: flex; flex-direction: column;
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg); overflow: hidden;
    transition: border-color .22s, box-shadow .22s, transform .22s;
  }
  .ccat:hover {
    border-color: var(--c-primary);
    box-shadow: 0 0 32px rgba(var(--c-primary-rgb), 0.2);
    transform: translateY(-3px);
  }
  .ccat--highlight {
    border-color: rgba(var(--c-primary-rgb), 0.38);
    box-shadow: 0 0 24px rgba(var(--c-primary-rgb), 0.12);
  }

  /* ─── Thumbnail ─── */
  .ccat__thumb {
    position: relative;
    aspect-ratio: 16/7; overflow: hidden;
    display: flex; align-items: center; justify-content: center;
  }
  .ccat__thumb-pixels {
    position: absolute; inset: 0;
    background-image: radial-gradient(circle, rgba(255,255,255,0.14) 1px, transparent 1px);
    background-size: 6px 6px; opacity: 0.7;
  }
  .ccat__thumb-glow { position: absolute; inset: 0; opacity: .9; }
  .ccat__thumb-icon {
    position: relative; z-index: 2;
    filter: drop-shadow(0 0 10px currentColor);
    transition: transform .22s;
  }
  .ccat:hover .ccat__thumb-icon { transform: scale(1.1); }

  .ccat__thumb-badge {
    position: absolute; top: 9px; left: 9px; z-index: 3;
    font-size: 0.6rem; font-weight: 700; letter-spacing: 0.07em;
    text-transform: uppercase; color: rgba(255,255,255,0.92);
    background: rgba(0,0,0,0.55); border: 1px solid rgba(255,255,255,0.15);
    backdrop-filter: blur(4px);
    padding: 0.2rem 0.6rem; border-radius: var(--radius-full);
  }

  /*
    ─── Colores por categoría ───
    Acentos temáticos intencionales (fuera de la paleta de tokens):
    cada categoría tiene su propia identidad cromática en el thumbnail.
  */
  .ccat--exterior .ccat__thumb {
    background: linear-gradient(135deg, #0a1628 0%, #0e2040 100%);
  }
  .ccat--exterior .ccat__thumb-glow {
    background: radial-gradient(ellipse at 50% 65%, rgba(255,130,0,.35) 0%, rgba(255,70,0,.12) 45%, transparent 70%);
  }
  .ccat--exterior .ccat__thumb-icon { color: rgba(255,160,50,.9); }

  .ccat--interior .ccat__thumb {
    background: linear-gradient(135deg, #090e20 0%, #0d1a3c 100%);
  }
  .ccat--interior .ccat__thumb-glow {
    background: radial-gradient(ellipse at 50% 65%, rgba(110,90,255,.4) 0%, rgba(60,40,210,.15) 45%, transparent 70%);
  }
  .ccat--interior .ccat__thumb-icon { color: rgba(160,140,255,.9); }

  .ccat--flexible .ccat__thumb {
    background: linear-gradient(135deg, #07101e 0%, #0a1a30 100%);
  }
  .ccat--flexible .ccat__thumb-glow {
    background: radial-gradient(ellipse at 50% 65%, rgba(0,210,170,.35) 0%, rgba(0,160,130,.12) 45%, transparent 70%);
  }
  .ccat--flexible .ccat__thumb-icon { color: rgba(0,230,185,.9); }

  .ccat--eventos .ccat__thumb {
    background: linear-gradient(135deg, #0c0a1c 0%, #180a2c 100%);
  }
  .ccat--eventos .ccat__thumb-glow {
    background: radial-gradient(ellipse at 50% 65%, rgba(200,50,255,.35) 0%, rgba(150,20,210,.12) 45%, transparent 70%);
  }
  .ccat--eventos .ccat__thumb-icon { color: rgba(215,100,255,.9); }

  .ccat--piso .ccat__thumb {
    background: linear-gradient(135deg, #060f12 0%, #091e24 100%);
  }
  .ccat--piso .ccat__thumb-glow {
    background: radial-gradient(ellipse at 50% 75%, rgba(0,220,110,.35) 0%, rgba(0,180,90,.12) 45%, transparent 70%);
  }
  .ccat--piso .ccat__thumb-icon { color: rgba(0,235,130,.9); }

  .ccat--transparente .ccat__thumb {
    background: linear-gradient(135deg, #07101e 0%, #0c1630 100%);
  }
  .ccat--transparente .ccat__thumb-glow {
    background: radial-gradient(ellipse at 50% 65%, rgba(0,185,255,.35) 0%, rgba(0,130,220,.12) 45%, transparent 70%);
  }
  .ccat--transparente .ccat__thumb-icon { color: rgba(80,210,255,.9); }

  /* ─── Body ─── */
  .ccat__body {
    padding: 1.25rem; flex: 1;
    display: flex; flex-direction: column; gap: 0.5rem;
  }
  .ccat__title {
    font-size: 1.0625rem; font-weight: 700;
    color: var(--c-ink); line-height: 1.25; letter-spacing: -.015em;
  }
  .ccat__desc {
    font-size: 0.875rem; color: var(--c-muted); line-height: 1.65; flex: 1;
  }
  .ccat__specs {
    display: flex; flex-wrap: wrap; gap: .375rem; margin-top: .25rem;
  }
  .ccat__spec {
    font-size: .6875rem; font-weight: 600; color: var(--c-muted);
    background: rgba(255,255,255,.04);
    border: 1px solid var(--c-border);
    border-radius: 4px; padding: .2rem .5rem;
  }
  /* Hereda .link-arrow (sistema global); solo ajuste de posición */
  .ccat__link { margin-top: .5rem; }

  /* ─── Footer ─── */
  /* El CTA usa .btn .btn--outline .btn--lg (sistema global) */
  .categorias-footer { display: flex; justify-content: center; }

  @media (max-width: 1024px) { .categorias-grid { grid-template-columns: repeat(2,1fr); } }
  @media (max-width: 640px)  { .categorias-grid { grid-template-columns: 1fr; } }
</style>

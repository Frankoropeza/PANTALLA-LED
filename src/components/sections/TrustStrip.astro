---
// TrustStrip.astro — Franja de 4 mini-cards de confianza
// Va entre la QuickNav y el contenido principal (patrón Firefighters MX).
// Genérico: recibe los items por props para reusarlo en otras páginas.

import IconCheck from '../ui/icons/IconCheck.astro'

interface Item {
  title: string
  desc: string
}

interface Props {
  items: Item[]
}

const { items } = Astro.props
---

<section class="section--sm trust-strip" aria-label="Garantías de compra">
  <div class="container">
    <ul class="trust-strip__grid">
      {items.map((item) => (
        <li class="tstrip">
          <span class="tstrip__icon" aria-hidden="true">
            <IconCheck size={15} strokeWidth={2.5} />
          </span>
          <div class="tstrip__body">
            <h2 class="tstrip__title">{item.title}</h2>
            <p class="tstrip__desc">{item.desc}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .trust-strip {
    background: var(--c-bg);
    border-bottom: 1px solid var(--c-border);
    padding-block: 2rem;
  }

  .trust-strip__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
  }

  .tstrip {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .tstrip__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: var(--radius-md);
    background: rgba(var(--c-success-rgb), 0.1);
    border: 1px solid rgba(var(--c-success-rgb), 0.25);
    color: var(--c-success);
    flex-shrink: 0;
  }

  .tstrip__title {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--c-ink);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.25rem;
    line-height: 1.3;
  }

  .tstrip__desc {
    font-size: 0.8125rem;
    color: var(--c-muted);
    line-height: 1.55;
  }

  @media (max-width: 1024px) {
    .trust-strip__grid { grid-template-columns: repeat(2, 1fr); gap: 1.25rem 1.5rem; }
  }
  @media (max-width: 640px) {
    .trust-strip__grid { grid-template-columns: 1fr; gap: 1rem; }
    .trust-strip { padding-block: 1.5rem; }
  }
</style>

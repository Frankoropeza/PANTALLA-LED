---
// FaqCotizacionIndex.astro — FAQ + formulario de cotización WhatsApp
// Layout 2 columnas: FAQ izquierda + formulario derecha

import { CONTACT, waUrl, WA_MESSAGES } from '../../config/site'
import { FAQS } from '../../config/faqs'
import IconWhatsApp from '../ui/icons/IconWhatsApp.astro'
import IconPhone from '../ui/icons/IconPhone.astro'
import IconCheck from '../ui/icons/IconCheck.astro'

const beneficios = [
  'Asesoría técnica incluida',
  'Propuesta con especificaciones detalladas',
  'Sin compromiso de compra',
  'Atención personalizada por WhatsApp',
]
---

<section class="section section--dark faq-section" id="faq" aria-labelledby="faq-heading">
  <div class="container">
    <div class="faq-layout">

      <!-- FAQ -->
      <div class="faq-col">
        <p class="sidebar-header__eyebrow">Resolvemos tus dudas</p>
        <h2 id="faq-heading" class="faq-title">
          Preguntas frecuentes sobre<br/>
          <span class="faq-title__accent">pantallas LED</span>
        </h2>

        <div class="faq-lista" role="list">
          {FAQS.map((item) => (
            <details class="faq-item" role="listitem">
              <summary class="faq-item__question">
                <span>{item.q}</span>
                <svg class="faq-item__chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <polyline points="6 9 12 15 18 9"/>
                </svg>
              </summary>
              <div class="faq-item__answer">
                <p>{item.a}</p>
              </div>
            </details>
          ))}
        </div>
      </div>

      <!-- Formulario / CTA -->
      <div class="faq-cta-col">
        <div class="cotizacion-card">
          <div class="cotizacion-card__header">
            <h3 class="cotizacion-card__title">Cotización gratuita</h3>
            <p class="cotizacion-card__subtitle">
              Respuesta garantizada en menos de 2 horas en horario hábil.
            </p>
          </div>

          <div class="cotizacion-card__body">
            {beneficios.map((b) => (
              <div class="cotizacion-benefit">
                <IconCheck size={16} />
                <span>{b}</span>
              </div>
            ))}
          </div>

          <div class="cotizacion-card__ctas">
            <a
              href={waUrl(WA_MESSAGES.cotizacion)}
              class="btn btn--whatsapp cotizacion-card__btn-wa"
              target="_blank"
              rel="noopener noreferrer"
            >
              <IconWhatsApp size={20} />
              Cotizar por WhatsApp
            </a>
            <a href={`tel:${CONTACT.phoneRaw}`} class="btn btn--outline cotizacion-card__btn-tel">
              <IconPhone size={18} />
              Llamar: {CONTACT.phone}
            </a>
          </div>

          <p class="cotizacion-card__horario">
            Lun–Vie 8:00–18:00 · Sáb 9:00–14:00
          </p>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  /* El fondo lo aporta .section--dark (sistema global) */

  .faq-layout {
    display: grid;
    grid-template-columns: 6fr 4fr;
    gap: 4rem;
    align-items: start;
  }

  /* ─── FAQ ─── */
  .faq-title {
    font-size: clamp(1.625rem, 2.5vw, 2.125rem);
    font-weight: 800;
    color: var(--c-ink);
    line-height: 1.12;
    letter-spacing: -0.025em;
    margin-bottom: 2rem;
  }

  .faq-title__accent { color: var(--c-primary); }

  .faq-lista {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .faq-item {
    border-bottom: 1px solid var(--c-border);
    overflow: hidden;
  }

  .faq-item:first-of-type { border-top: 1px solid var(--c-border); }

  .faq-item__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 0;
    cursor: pointer;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--c-ink);
    list-style: none;
    transition: color 0.15s;
    user-select: none;
  }

  .faq-item__question::-webkit-details-marker { display: none; }
  .faq-item[open] .faq-item__question { color: var(--c-primary); }
  .faq-item__question:hover { color: var(--c-primary); }

  .faq-item__chevron { flex-shrink: 0; transition: transform 0.2s ease; opacity: 0.6; }
  .faq-item[open] .faq-item__chevron { transform: rotate(180deg); opacity: 1; }

  .faq-item__answer {
    padding-bottom: 1rem;
  }

  .faq-item__answer p {
    font-size: 0.9rem;
    color: var(--c-muted);
    line-height: 1.75;
  }

  /* ─── Cotización card ─── */
  .cotizacion-card {
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: 14px;
    overflow: hidden;
    position: sticky;
    top: calc(var(--stack-height) + 2rem);
  }

  .cotizacion-card__header {
    padding: 1.5rem 1.5rem 1.25rem;
    border-bottom: 1px solid var(--c-border);
    background: var(--c-primary-light);
    border-top: 3px solid var(--c-primary);
  }

  .cotizacion-card__title {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--c-ink);
    margin-bottom: 0.375rem;
  }

  .cotizacion-card__subtitle {
    font-size: 0.8125rem;
    color: var(--c-muted);
    line-height: 1.5;
  }

  .cotizacion-card__body {
    padding: 1.25rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .cotizacion-benefit {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--c-ink-2);
  }
  .cotizacion-benefit svg { color: var(--c-success); flex-shrink: 0; }

  /* CTAs: usan .btn--whatsapp / .btn--outline; aquí solo van full-width */
  .cotizacion-card__ctas {
    padding: 0 1.5rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .cotizacion-card__btn-wa,
  .cotizacion-card__btn-tel {
    width: 100%;
    justify-content: center;
  }

  .cotizacion-card__horario {
    padding: 0 1.5rem 1.25rem;
    font-size: 0.75rem;
    color: var(--c-muted);
    text-align: center;
  }

  /* ─── Responsive ─── */
  @media (max-width: 1024px) {
    .faq-layout { grid-template-columns: 1fr; gap: 2.5rem; }
    .cotizacion-card { position: static; }
  }
</style>

---
// CoberturaIndex.astro — Cobertura nacional de instalación y entrega
// Muestra las ciudades con servicio activo y la promesa de cobertura nacional

import { url } from '../../utils/url'
import IconArrowRight from '../ui/icons/IconArrowRight.astro'
import IconInfo from '../ui/icons/IconInfo.astro'

const zonas = [
  {
    type: 'flagship',
    ciudad: 'Ciudad de México',
    region: 'Valle de México',
    desc: 'Base de operaciones principal. Instalación, mantenimiento y atención presencial.',
    turnaround: 'Mismo día',
  },
  {
    type: 'flagship',
    ciudad: 'Estado de México',
    region: 'Valle de México',
    desc: 'Cobertura completa en 125 municipios del EdoMex. Flota de servicio propia.',
    turnaround: 'Mismo día',
  },
  {
    type: 'comercial',
    ciudad: 'Guadalajara',
    region: 'Occidente',
    desc: 'Instaladores certificados con base en la ZMG. Servicio completo en la región.',
    turnaround: '24–48 hrs',
  },
  {
    type: 'comercial',
    ciudad: 'Monterrey',
    region: 'Noreste',
    desc: 'Red de soporte en el área metropolitana de Monterrey y ciudades cercanas.',
    turnaround: '24–48 hrs',
  },
  {
    type: 'comercial',
    ciudad: 'Puebla',
    region: 'Centro-Sur',
    desc: 'Cobertura en la ciudad y zona metropolitana con técnicos en sitio.',
    turnaround: '24–48 hrs',
  },
  {
    type: 'comercial',
    ciudad: 'Cancún',
    region: 'Sureste',
    desc: 'Servicio activo en Cancún y Rivera Maya para proyectos hoteleros y comerciales.',
    turnaround: '48–72 hrs',
  },
]

const stats = [
  { value: '32', label: 'Estados con entrega' },
  { value: '+500', label: 'Proyectos en México' },
  { value: '10+', label: 'Años de experiencia' },
]
---

<section class="section section--surface cobertura-section" id="cobertura" aria-labelledby="cobertura-heading">
  <div class="container">

    <div class="split-layout cobertura-layout">

      <!-- Columna izquierda: header + stats -->
      <div class="split-layout__sidebar cobertura-left">
        <p class="sidebar-header__eyebrow">Cobertura nacional</p>
        <h2 id="cobertura-heading" class="sidebar-header__title">
          Instalamos en todo<br/><span>México</span>
        </h2>
        <p class="sidebar-header__desc">
          Con base en Ciudad de México y red de instaladores certificados en las principales ciudades del país,
          llevamos tecnología LED profesional a cualquier rincón de la República.
        </p>

        <!-- Estadísticas -->
        <div class="stat-row cobertura-stats" role="list">
          {stats.map((s) => (
            <div class="stat" role="listitem">
              <span class="stat__value">{s.value}</span>
              <span class="stat__label">{s.label}</span>
            </div>
          ))}
        </div>

        <a href={url('/contacto/')} class="btn btn--primary cobertura-cta">
          Verificar cobertura en mi ciudad
          <IconArrowRight size={16} />
        </a>

        <!-- Nota nacional -->
        <p class="cobertura-note">
          <IconInfo size={14} />
          Entrega a todo México. Coordina instalación local o envía con guía prepagada.
        </p>
      </div>

      <!-- Columna derecha: tarjetas de zonas -->
      <div class="cobertura-grid" role="list">
        {zonas.map((z) => (
          <article class:list={['czona', `czona--${z.type}`]} role="listitem">
            <div class="czona__header">
              <span class="czona__pin" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/>
                  <circle cx="12" cy="10" r="3"/>
                </svg>
              </span>
              <div class="czona__city-info">
                <h3 class="czona__city">{z.ciudad}</h3>
                <span class="czona__region">{z.region}</span>
              </div>
              <span class:list={['czona__badge', `czona__badge--${z.type}`]}>
                {z.type === 'flagship' ? 'Base propia' : 'Red certificada'}
              </span>
            </div>
            <p class="czona__desc">{z.desc}</p>
            <div class="czona__footer">
              <span class="czona__turnaround">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="10"/>
                  <polyline points="12 6 12 12 16 14"/>
                </svg>
                Respuesta: <strong>{z.turnaround}</strong>
              </span>
            </div>
          </article>
        ))}
      </div>

    </div>
  </div>
</section>

<style>
  /* Fondo: .section--surface · Layout: .split-layout · Header: .sidebar-header
     Stats: .stat-row / .stat — todo del sistema global */

  .cobertura-stats {
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--c-border);
    margin-bottom: 1.75rem;
  }

  .cobertura-cta { margin-bottom: 1rem; }

  .cobertura-note {
    display: flex;
    align-items: flex-start;
    gap: 0.4rem;
    font-size: 0.8125rem;
    color: var(--c-muted);
    line-height: 1.5;
  }
  .cobertura-note svg { flex-shrink: 0; margin-top: 0.1rem; }

  /* ─── Grid ciudades: 2 columnas ─── */
  .cobertura-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
    align-content: start;
  }

  /* ─── Tarjeta de zona ─── */
  .czona {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
    padding: 1.375rem 1.5rem;
    transition: border-color .2s var(--ease), box-shadow .2s var(--ease), transform .2s var(--ease);
  }
  .czona:hover {
    border-color: rgba(var(--c-primary-rgb), 0.4);
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.35), 0 0 20px rgba(var(--c-primary-rgb), 0.1);
    transform: translateY(-3px);
  }
  .czona--flagship {
    border-color: rgba(var(--c-primary-rgb), 0.28);
    background: linear-gradient(150deg, var(--c-surface) 0%, rgba(var(--c-primary-rgb), 0.06) 100%);
  }

  /* ─── Header: pin + ciudad + badge ─── */
  .czona__header {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .czona__pin {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: var(--radius-md);
    background: var(--c-primary-light);
    border: 1px solid rgba(var(--c-primary-rgb), 0.25);
    color: var(--c-primary);
    flex-shrink: 0;
    transition: background .2s var(--ease), color .2s var(--ease);
  }
  .czona:hover .czona__pin {
    background: var(--c-primary);
    color: var(--c-white);
  }

  .czona__city-info {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    flex: 1;
    min-width: 0;
  }
  .czona__city {
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--c-ink);
    line-height: 1.2;
    letter-spacing: -0.015em;
  }
  .czona__region {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--c-muted);
  }

  .czona__badge {
    font-size: 0.5625rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.3rem 0.65rem;
    border-radius: var(--radius-full);
    flex-shrink: 0;
    white-space: nowrap;
  }
  .czona__badge--flagship {
    background: rgba(var(--c-primary-rgb), 0.15);
    color: var(--c-primary-soft);
    border: 1px solid rgba(var(--c-primary-rgb), 0.3);
  }
  .czona__badge--comercial {
    background: rgba(255, 255, 255, 0.05);
    color: var(--c-muted);
    border: 1px solid var(--c-border);
  }

  /* ─── Contenido ─── */
  .czona__desc {
    font-size: 0.875rem;
    color: var(--c-muted);
    line-height: 1.65;
    flex: 1;
  }

  .czona__footer {
    padding-top: 0.875rem;
    border-top: 1px solid var(--c-border);
  }
  .czona__turnaround {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    color: var(--c-muted);
  }
  .czona__turnaround strong { color: var(--c-ink); font-weight: 700; }
  .czona__turnaround svg { color: var(--c-primary); flex-shrink: 0; }

  /* El colapso del layout sidebar lo maneja .split-layout (sistema global) */
  @media (max-width: 640px) {
    .cobertura-grid { grid-template-columns: 1fr; gap: 1rem; }
    .czona { padding: 1.25rem; }
  }
</style>

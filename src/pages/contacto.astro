---
/**
 * contacto.astro — Contacto y cotización (L2)
 * Orquestador: PageHero + formulario-a-WhatsApp + canales de contacto +
 * cobertura. El formulario no requiere backend: arma el mensaje y abre
 * wa.me con los datos prellenados.
 * Schemas: BreadcrumbList + ContactPage.
 */

import Base from '../layouts/Base.astro'
import PageHero from '../components/sections/PageHero.astro'
import CoberturaIndex from '../components/sections/CoberturaIndex.astro'
import IconWhatsApp from '../components/ui/icons/IconWhatsApp.astro'
import IconPhone from '../components/ui/icons/IconPhone.astro'
import IconCheck from '../components/ui/icons/IconCheck.astro'

import { SITE, CONTACT, waUrl, WA_MESSAGES } from '../config/site'

const tiposProyecto = [
  'Compra de pantalla LED',
  'Renta para evento',
  'Instalación',
  'Mantenimiento',
  'Asesoría técnica',
  'Otro',
]

const beneficios = [
  'Respuesta en menos de 2 horas en horario hábil',
  'Asesoría técnica incluida, sin compromiso de compra',
  'Propuesta con especificaciones y cronograma',
]

// ─── Meta SEO ─────────────────────────────────────────────────────────────────
const title = 'Contacto y Cotización de Pantallas LED | Respuesta en 2 Horas — PantallaLED'
const description =
  'Cotiza tu pantalla LED hoy: WhatsApp, teléfono o formulario. Respuesta garantizada en menos de 2 horas en horario hábil, asesoría técnica gratuita y cobertura en toda la República Mexicana.'
const canonical = `${SITE.url}/contacto/`

// ─── JSON-LD ──────────────────────────────────────────────────────────────────
const schemaBreadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Contacto', item: canonical },
  ],
}

const schemaContact = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: title,
  url: canonical,
  about: { '@id': `${SITE.url}/#organization` },
}
---

<Base {title} {description} {canonical}>

  <!-- ─── Hero L2 ──────────────────────────────────────────────────────── -->
  <PageHero
    eyebrow="Cotización gratuita"
    title="Hablemos de tu <span>proyecto LED</span>"
    desc="Cuéntanos qué necesitas y recibe una propuesta con especificaciones técnicas, tiempos y precio — sin costo ni compromiso. Respuesta garantizada en menos de 2 horas en horario hábil."
    crumbs={[
      { label: 'Inicio', href: '/' },
      { label: 'Contacto' },
    ]}
  />

  <!-- ─── Formulario + canales ─────────────────────────────────────────── -->
  <section class="section section--surface" aria-labelledby="contacto-heading">
    <div class="container">
      <div class="contacto-layout">

        <!-- Formulario → WhatsApp -->
        <div class="cot-form-card">
          <h2 id="contacto-heading" class="cot-form-card__title">Cotiza en 1 minuto</h2>
          <p class="cot-form-card__subtitle">
            Completa el formulario y el mensaje llega directo a nuestro WhatsApp con tus datos.
          </p>

          <form class="cot-form" id="cotizacion-form">
            <div class="cot-form__row">
              <div class="cot-field">
                <label for="f-nombre">Nombre *</label>
                <input type="text" id="f-nombre" name="nombre" required placeholder="Tu nombre" autocomplete="name" />
              </div>
              <div class="cot-field">
                <label for="f-empresa">Empresa</label>
                <input type="text" id="f-empresa" name="empresa" placeholder="Opcional" autocomplete="organization" />
              </div>
            </div>

            <div class="cot-form__row">
              <div class="cot-field">
                <label for="f-tipo">Tipo de proyecto *</label>
                <select id="f-tipo" name="tipo" required>
                  <option value="" disabled selected>Selecciona una opción</option>
                  {tiposProyecto.map((t) => (
                    <option value={t}>{t}</option>
                  ))}
                </select>
              </div>
              <div class="cot-field">
                <label for="f-ciudad">Ciudad *</label>
                <input type="text" id="f-ciudad" name="ciudad" required placeholder="CDMX, Guadalajara…" autocomplete="address-level2" />
              </div>
            </div>

            <div class="cot-field">
              <label for="f-mensaje">Cuéntanos tu proyecto *</label>
              <textarea
                id="f-mensaje"
                name="mensaje"
                required
                rows="4"
                placeholder="Dimensiones aproximadas, ubicación (interior/exterior), fecha estimada…"
              ></textarea>
            </div>

            <button type="submit" class="btn btn--whatsapp btn--lg cot-form__submit">
              <IconWhatsApp size={20} />
              Enviar por WhatsApp
            </button>
            <p class="cot-form__nota">Sin compromiso · Te respondemos al instante en horario hábil</p>
          </form>
        </div>

        <!-- Canales de contacto -->
        <aside class="contacto-info" aria-label="Canales de contacto">

          <div class="cinfo-card">
            <h3 class="cinfo-card__title">Canales directos</h3>
            <ul class="cinfo-card__list">
              <li class="cinfo-item">
                <span class="cinfo-item__icon"><IconWhatsApp size={17} /></span>
                <div>
                  <span class="cinfo-item__label">WhatsApp</span>
                  <a
                    href={waUrl(WA_MESSAGES.contacto)}
                    class="cinfo-item__value"
                    target="_blank"
                    rel="noopener noreferrer"
                  >Escríbenos ahora →</a>
                </div>
              </li>
              <li class="cinfo-item">
                <span class="cinfo-item__icon"><IconPhone size={16} /></span>
                <div>
                  <span class="cinfo-item__label">Teléfono</span>
                  <a href={`tel:${CONTACT.phoneRaw}`} class="cinfo-item__value">{CONTACT.phone}</a>
                </div>
              </li>
              <li class="cinfo-item">
                <span class="cinfo-item__icon">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                    <polyline points="22,6 12,13 2,6"/>
                  </svg>
                </span>
                <div>
                  <span class="cinfo-item__label">Email</span>
                  <a href={`mailto:${CONTACT.email}`} class="cinfo-item__value">{CONTACT.email}</a>
                </div>
              </li>
            </ul>
          </div>

          <div class="cinfo-card cinfo-card--horario">
            <h3 class="cinfo-card__title">Horario de atención</h3>
            <ul class="cinfo-horario">
              <li><span>Lunes – Viernes</span><strong>8:00 – 18:00</strong></li>
              <li><span>Sábado</span><strong>9:00 – 14:00</strong></li>
              <li><span>Domingo</span><strong>Solo urgencias</strong></li>
            </ul>
            <p class="cinfo-card__nota">Soporte técnico 24/7 para clientes con póliza</p>
          </div>

          <div class="cinfo-card">
            <h3 class="cinfo-card__title">Qué incluye tu cotización</h3>
            <ul class="cinfo-beneficios">
              {beneficios.map((b) => (
                <li>
                  <IconCheck size={15} />
                  {b}
                </li>
              ))}
            </ul>
          </div>

        </aside>

      </div>
    </div>
  </section>

  <!-- ─── Cobertura (sección compartida) ───────────────────────────────── -->
  <CoberturaIndex />

  <!-- ─── JSON-LD ──────────────────────────────────────────────────────── -->
  <script type="application/ld+json" set:html={JSON.stringify(schemaBreadcrumb)} />
  <script type="application/ld+json" set:html={JSON.stringify(schemaContact)} />

  <!-- Formulario → WhatsApp (sin backend) -->
  <script define:vars={{ whatsapp: CONTACT.whatsapp }}>
    document.getElementById('cotizacion-form')?.addEventListener('submit', (e) => {
      e.preventDefault()
      const f = new FormData(e.target)
      const lineas = [
        'Hola, quiero cotizar un proyecto de pantalla LED:',
        `• Nombre: ${f.get('nombre')}`,
        f.get('empresa') ? `• Empresa: ${f.get('empresa')}` : null,
        `• Tipo: ${f.get('tipo')}`,
        `• Ciudad: ${f.get('ciudad')}`,
        `• Proyecto: ${f.get('mensaje')}`,
      ].filter(Boolean)
      const url = `https://wa.me/${whatsapp}?text=${encodeURIComponent(lineas.join('\n'))}`
      window.open(url, '_blank', 'noopener')
    })
  </script>

</Base>

<style>
  /* ─── Layout 2 columnas ─── */
  .contacto-layout {
    display: grid;
    grid-template-columns: 6fr 4fr;
    gap: 2rem;
    align-items: start;
  }

  /* ─── Card del formulario ─── */
  .cot-form-card {
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-xl);
    border-top: 3px solid var(--c-primary);
    padding: 2rem;
  }
  .cot-form-card__title {
    font-size: 1.5rem;
    font-weight: var(--weight-black);
    color: var(--c-ink);
    letter-spacing: -0.02em;
    margin-bottom: 0.375rem;
  }
  .cot-form-card__subtitle {
    font-size: 0.875rem;
    color: var(--c-muted);
    line-height: 1.6;
    margin-bottom: 1.75rem;
  }

  /* ─── Campos ─── */
  .cot-form {
    display: flex;
    flex-direction: column;
    gap: 1.125rem;
  }
  .cot-form__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.125rem;
  }

  .cot-field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .cot-field label {
    font-size: 0.8125rem;
    font-weight: var(--weight-semibold);
    color: var(--c-ink-2);
  }
  .cot-field input,
  .cot-field select,
  .cot-field textarea {
    font-family: var(--font-sans);
    font-size: 16px; /* iOS no-zoom */
    color: var(--c-ink);
    background: var(--c-bg-2);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-md);
    padding: 0.75rem 1rem;
    min-height: 48px;
    transition: border-color var(--transition), box-shadow var(--transition);
  }
  .cot-field textarea { resize: vertical; min-height: 110px; }
  .cot-field input::placeholder,
  .cot-field textarea::placeholder { color: var(--c-muted); opacity: 0.7; }
  .cot-field input:focus,
  .cot-field select:focus,
  .cot-field textarea:focus {
    outline: none;
    border-color: var(--c-primary);
    box-shadow: 0 0 0 3px rgba(var(--c-primary-rgb), 0.15);
  }

  .cot-form__submit { width: 100%; justify-content: center; }
  .cot-form__nota {
    font-size: 0.75rem;
    color: var(--c-muted);
    text-align: center;
  }

  /* ─── Cards de info ─── */
  .contacto-info {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    position: sticky;
    top: calc(var(--stack-height) + 2rem);
  }

  .cinfo-card {
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
  }
  .cinfo-card--horario {
    background: linear-gradient(150deg, var(--c-surface) 0%, rgba(var(--c-primary-rgb), 0.06) 100%);
    border-color: rgba(var(--c-primary-rgb), 0.28);
  }
  .cinfo-card__title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--c-ink);
    margin-bottom: 1rem;
    letter-spacing: -0.01em;
  }
  .cinfo-card__nota {
    font-size: 0.75rem;
    color: var(--c-primary-soft);
    font-weight: var(--weight-medium);
    margin-top: 0.875rem;
  }

  .cinfo-card__list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .cinfo-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }
  .cinfo-item__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-md);
    background: var(--c-primary-light);
    border: 1px solid rgba(var(--c-primary-rgb), 0.25);
    color: var(--c-primary);
    flex-shrink: 0;
  }
  .cinfo-item__label {
    display: block;
    font-size: 0.6875rem;
    font-weight: var(--weight-semibold);
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--c-muted);
    margin-bottom: 0.15rem;
  }
  .cinfo-item__value {
    font-size: 0.9375rem;
    font-weight: var(--weight-semibold);
    color: var(--c-ink);
    transition: color var(--transition);
  }
  .cinfo-item__value:hover { color: var(--c-primary); }

  .cinfo-horario {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .cinfo-horario li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.875rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px dashed var(--c-border);
  }
  .cinfo-horario li:last-child { border-bottom: none; padding-bottom: 0; }
  .cinfo-horario span { color: var(--c-muted); }
  .cinfo-horario strong { color: var(--c-ink); font-weight: 600; }

  .cinfo-beneficios {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }
  .cinfo-beneficios li {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.8438rem;
    color: var(--c-ink-2);
    line-height: 1.55;
  }
  .cinfo-beneficios li :global(svg) {
    color: var(--c-success);
    flex-shrink: 0;
    margin-top: 0.2rem;
  }

  /* ─── Responsive ─── */
  @media (max-width: 1024px) {
    .contacto-layout { grid-template-columns: 1fr; }
    .contacto-info { position: static; }
  }
  @media (max-width: 640px) {
    .cot-form-card { padding: 1.5rem 1.25rem; }
    .cot-form__row { grid-template-columns: 1fr; }
  }
</style>

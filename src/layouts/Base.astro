---
import '../styles/global.css'
import TopBar       from '../components/global/TopBar.astro'
import Header       from '../components/global/Header.astro'
import Footer       from '../components/global/Footer.astro'
import WhatsAppButton from '../components/global/WhatsAppButton.astro'
import { url } from '../utils/url'

interface Props {
  title: string
  description: string
  canonical?: string
  ogImage?: string
}

const { title, description, canonical, ogImage } = Astro.props
const canonicalURL = canonical || new URL(Astro.url.pathname, Astro.site).href
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="color-scheme" content="dark" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />

  <!-- Open Graph -->
  <meta property="og:title"       content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url"         content={canonicalURL} />
  <meta property="og:type"        content="website" />
  <meta property="og:site_name"   content="PantallaLED" />
  <meta property="og:locale"      content="es_MX" />
  {ogImage && <meta property="og:image" content={ogImage} />}

  <!-- Twitter Card -->
  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:title"       content={title} />
  <meta name="twitter:description" content={description} />
  {ogImage && <meta name="twitter:image" content={ogImage} />}

  <meta name="robots" content="index, follow" />
  <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
  <link rel="apple-touch-icon"     href={url('/apple-touch-icon.png')} />

  <!-- Google Fonts — Outfit (mismo que PROYECTORED para coherencia de sistema) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  />
</head>
<body>
  <TopBar />
  <Header />
  <main>
    <!--
      REGLA DE LAYOUT — válida para todas las páginas:
      Orden obligatorio: Hero → QuickNav (index) / contenido → CTA Final.
    -->
    <slot />
  </main>
  <Footer />
  <WhatsAppButton />
</body>
</html>

<!--
  Los design tokens, reset, botones y overrides responsive viven en
  src/styles/global.css (importado arriba) — única fuente de verdad.
-->

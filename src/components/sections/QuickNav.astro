---
// QuickNav.astro — Barra de navegación rápida segmentada
// Banda naranja de ancho completo: cada botón ocupa una celda igual
// del 100% del viewport. Va inmediatamente después del hero.
// Props: label (accesibilidad), enlaces y mensaje del CTA WhatsApp.

import { waUrl } from '../../config/site'
import IconWhatsApp from '../ui/icons/IconWhatsApp.astro'

interface Enlace {
  label: string
  href: string
}

interface Props {
  label?: string
  enlaces: Enlace[]
  ctaLabel?: string
  ctaMessage: string
  /** accent = banda naranja (bajo el hero) · primary = banda azul (pre-footer) */
  variant?: 'accent' | 'primary'
}

const {
  label = 'Navegación rápida de secciones',
  enlaces,
  ctaLabel = 'Cotizar ahora',
  ctaMessage,
  variant = 'accent',
} = Astro.props
---

<nav class:list={['quicknav', `quicknav--${variant}`]} aria-label={label}>
  <ul class="quicknav__list">
    {enlaces.map((e) => (
      <li class="quicknav__item">
        <a href={e.href} class="quicknav__btn">{e.label}</a>
      </li>
    ))}
    <li class="quicknav__item">
      <a
        href={waUrl(ctaMessage)}
        class="quicknav__btn quicknav__btn--cta"
        target="_blank"
        rel="noopener noreferrer"
      >
        <IconWhatsApp size={15} />
        {ctaLabel}
      </a>
    </li>
  </ul>
</nav>

<style>
  /*
    Banda de acento naranja LED (--c-accent) — contraste deliberado
    contra el azul dominante del sitio. Barra segmentada full-bleed:
    todos los botones ocupan celdas iguales del 100% del ancho.
  */
  .quicknav {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  /* Variante naranja (bajo el hero) */
  .quicknav--accent {
    background: linear-gradient(120deg, var(--c-accent) 0%, #E85B00 55%, var(--c-accent-dark) 100%);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.18),
      0 8px 24px rgba(var(--c-accent-rgb), 0.18);
  }

  /* Variante azul (pre-footer) */
  .quicknav--primary {
    background: linear-gradient(120deg, #1A7FE8 0%, var(--c-primary) 45%, var(--c-primary-dark) 100%);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.16),
      0 -8px 24px rgba(var(--c-primary-rgb), 0.15);
  }
  /* Brillo diagonal sutil */
  .quicknav::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, rgba(255, 255, 255, 0.12) 0%, transparent 35%, transparent 70%, rgba(0, 0, 0, 0.12) 100%);
    pointer-events: none;
  }

  /* ─── Grid de celdas iguales, 100% del viewport ─── */
  .quicknav__list {
    position: relative;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    width: 100%;
  }

  /* Separadores entre celdas (también entre filas al envolver) */
  .quicknav__item {
    display: flex;
    box-shadow:
      inset 1px 0 0 rgba(255, 255, 255, 0.18),
      inset 0 1px 0 rgba(255, 255, 255, 0.18);
  }

  .quicknav__btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    width: 100%;
    min-height: 56px;
    padding: 0.875rem 0.75rem;
    text-align: center;
    font-size: clamp(0.75rem, 0.95vw, 0.875rem);
    font-weight: var(--weight-bold);
    line-height: 1.2;
    color: var(--c-white);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.12);
    letter-spacing: 0.01em;
    transition: background var(--transition), color var(--transition), text-shadow var(--transition);
  }
  .quicknav--accent .quicknav__btn:hover {
    background: var(--c-white);
    color: var(--c-accent-dark);
    text-shadow: none;
  }
  .quicknav--primary .quicknav__btn:hover {
    background: var(--c-white);
    color: var(--c-primary-dark);
    text-shadow: none;
  }

  /* CTA: celda blanca con identidad WhatsApp */
  .quicknav__btn--cta {
    background: var(--c-white);
    color: #128C46;
    text-shadow: none;
  }
  .quicknav__btn--cta:hover {
    background: #F2FBF5;
    color: var(--color-whatsapp-hover);
  }
  .quicknav__btn--cta :global(svg) { flex-shrink: 0; color: #25D366; }

  /* ─── Responsive: celdas siempre iguales, en filas ─── */
  @media (max-width: 1200px) {
    .quicknav__list {
      grid-auto-flow: row;
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (max-width: 640px) {
    .quicknav__list { grid-template-columns: repeat(2, 1fr); }
    .quicknav__btn {
      min-height: 50px;
      font-size: 0.8125rem;
    }
  }
</style>

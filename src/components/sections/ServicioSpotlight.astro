---
// ServicioSpotlight.astro — Sección de detalle SEO por servicio
// Gemela de CategoriaSpotlight: split layout con sidebar sticky
// (badge + H2 + intro + CTAs) | grid 2×2 de alcances.
// El id de la sección es el ancla pública /servicios/#<id>.
// Datos: config/servicios.ts.

import type { Servicio } from '../../config/servicios'
import IconWhatsApp from '../ui/icons/IconWhatsApp.astro'
import IconArrowRight from '../ui/icons/IconArrowRight.astro'
import IconCheck from '../ui/icons/IconCheck.astro'
import { waUrl, WA_MESSAGES } from '../../config/site'
import { url } from '../../utils/url'

interface Props {
  servicio: Servicio
  /** índice para alternar fondo (par = dark, impar = surface) */
  index: number
}

const { servicio: svc, index } = Astro.props
const fondo = index % 2 === 0 ? 'section--dark' : 'section--surface'
const headingId = `${svc.id}-heading`
const waMensaje = `${WA_MESSAGES.servicios} — ${svc.title}`
---

<section
  id={svc.id}
  class:list={['section', fondo, 'sspot']}
  aria-labelledby={headingId}
>
  <div class="container">
    <div class="split-layout">

      <!-- Sidebar: contexto + CTAs -->
      <div class="split-layout__sidebar">
        <p class="sspot__badge">Servicio {svc.num}</p>
        <h2 id={headingId} class="sidebar-header__title" set:html={svc.title} />
        <p class="sspot__intro">{svc.intro}</p>

        <div class="sspot__ctas">
          <a
            href={waUrl(waMensaje)}
            class="btn btn--whatsapp"
            target="_blank"
            rel="noopener noreferrer"
          >
            <IconWhatsApp size={17} />
            Cotizar este servicio
          </a>
          <a href={url('/contacto/')} class="link-arrow">
            Agendar asesoría gratuita
            <IconArrowRight size={14} />
          </a>
        </div>
      </div>

      <!-- Grid 2×2 de alcances -->
      <div class="sspot__grid" role="list">
        {svc.features.map((f) => (
          <article class="sspot-card" role="listitem">
            <span class="sspot-card__icon" aria-hidden="true">
              <IconCheck size={14} strokeWidth={2.5} />
            </span>
            <p class="sspot-card__text">{f}</p>
          </article>
        ))}
      </div>

    </div>
  </div>
</section>

<style>
  .sspot__badge {
    display: inline-block;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-primary-soft);
    background: rgba(var(--c-primary-rgb), 0.12);
    border: 1px solid rgba(var(--c-primary-rgb), 0.3);
    border-radius: var(--radius-full);
    padding: 0.35rem 0.8rem;
    margin-bottom: 1rem;
  }

  .sspot__intro {
    font-size: 0.9375rem;
    color: var(--c-muted);
    line-height: 1.75;
    margin-bottom: 1.75rem;
  }

  .sspot__ctas {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }

  /* ─── Cards de alcance — receta canónica compacta ─── */
  .sspot__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
    align-content: start;
  }

  .sspot-card {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
    padding: 1.375rem 1.5rem;
    transition: border-color .2s var(--ease), box-shadow .2s var(--ease), transform .2s var(--ease);
  }
  .sspot-card:hover {
    border-color: rgba(var(--c-primary-rgb), 0.4);
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.35), 0 0 20px rgba(var(--c-primary-rgb), 0.1);
    transform: translateY(-3px);
  }

  .sspot-card__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: var(--radius-md);
    background: rgba(var(--c-success-rgb), 0.1);
    border: 1px solid rgba(var(--c-success-rgb), 0.25);
    color: var(--c-success);
    flex-shrink: 0;
  }

  .sspot-card__text {
    font-size: 0.9rem;
    font-weight: var(--weight-medium);
    color: var(--c-ink-2);
    line-height: 1.6;
  }

  /* ─── Responsive ─── */
  /* El colapso del split lo maneja .split-layout (sistema global) */
  @media (max-width: 640px) {
    .sspot__grid { grid-template-columns: 1fr; gap: 1rem; }
    .sspot-card { padding: 1.25rem; }
    .sspot__ctas :global(.btn) { width: 100%; justify-content: center; }
  }
</style>

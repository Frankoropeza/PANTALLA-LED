---
// HeroIndex.astro — Hero principal del sitio
// Layout split: texto izquierda + panel LED visual derecha

import { waUrl, WA_MESSAGES } from '../../config/site'
import { url } from '../../utils/url'
---

<section class="hero" aria-labelledby="hero-heading">

  <div class="hero__bg" aria-hidden="true">
    <div class="hero__grid"></div>
    <div class="hero__glow hero__glow--tl"></div>
    <div class="hero__glow hero__glow--br"></div>
  </div>

  <div class="container hero__inner">

    <!-- ── Columna de texto ── -->
    <div class="hero__content">

      <p class="hero__eyebrow">
        <span class="hero__eyebrow-dot" aria-hidden="true"></span>
        Proveedor directo · Sin intermediarios · Garantía 2 años
      </p>

      <h1 id="hero-heading" class="hero__title">
        Pantallas LED de<br/>
        Alta Resolución<br/>
        <span class="hero__title-accent">para México</span>
      </h1>

      <p class="hero__desc">
        Venta, renta e instalación de pantallas LED para publicidad exterior,
        interiores, eventos y espectaculares. Tecnología SMD y COB con cotización
        gratuita el mismo día en toda la República Mexicana.
      </p>

      <div class="hero__ctas">
        <a href={url('/productos/')} class="hero__btn-primary">
          Ver catálogo LED
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
        <a
          href={waUrl(WA_MESSAGES.cotizacion)}
          class="hero__btn-wa"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          Cotizar por WhatsApp
        </a>
      </div>

      <div class="hero__trust">
        <span class="hero__trust-item">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
          Garantía 2 años
        </span>
        <span class="hero__trust-item">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
          Entrega en todo México
        </span>
        <span class="hero__trust-item">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
          Instalación certificada
        </span>
        <span class="hero__trust-item">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
          Soporte 24/7
        </span>
      </div>
    </div>

    <!-- ── Visual: panel LED simulado ── -->
    <div class="hero__visual" aria-hidden="true">
      <div class="led-panel">

        <!-- Marco exterior -->
        <div class="led-panel__bezel">

          <!-- Pantalla interior -->
          <div class="led-panel__screen">
            <div class="led-panel__pixels"></div>
            <div class="led-panel__scan"></div>

            <!-- Contenido del panel -->
            <div class="led-panel__content">
              <span class="led-text led-text--sm">PANTALLA LED</span>
              <span class="led-text led-text--lg">P4</span>
              <span class="led-text led-text--sm">5,000 NITS · IP65</span>
              <div class="led-bar">
                <div class="led-bar__fill"></div>
              </div>
            </div>
          </div>

          <!-- Indicadores -->
          <div class="led-indicators">
            <span class="led-dot led-dot--green"></span>
            <span class="led-dot led-dot--blue"></span>
            <span class="led-dot led-dot--amber"></span>
          </div>
        </div>

        <!-- Specs flotantes -->
        <div class="led-spec led-spec--tl">
          <span class="led-spec__badge">IP65</span>
          Intemperie
        </div>
        <div class="led-spec led-spec--tr">
          <span class="led-spec__badge">SMD</span>
          Alta res.
        </div>
        <div class="led-spec led-spec--bl">
          <span class="led-spec__badge">COB</span>
          10 Bits
        </div>
        <div class="led-spec led-spec--br">
          <span class="led-spec__badge">24/7</span>
          Soporte
        </div>

        <!-- Glow ambiental -->
        <div class="led-panel__glow"></div>
      </div>
    </div>

  </div>
</section>

<style>
  /* ─── Sección ─── */
  .hero {
    position: relative;
    min-height: 92vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    padding-block: clamp(5rem, 8vw, 7rem);
  }

  /* ─── Fondo ─── */
  .hero__bg { position: absolute; inset: 0; pointer-events: none; }

  .hero__grid {
    position: absolute; inset: 0;
    opacity: 0.05;
    background-image:
      linear-gradient(rgba(0,102,204,1) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0,102,204,1) 1px, transparent 1px);
    background-size: 64px 64px;
  }

  .hero__glow {
    position: absolute; border-radius: 50%; filter: blur(120px);
  }
  .hero__glow--tl {
    top: -20%; left: -5%;
    width: 50vw; height: 60vh;
    background: radial-gradient(ellipse, rgba(0,102,204,0.22) 0%, transparent 70%);
  }
  .hero__glow--br {
    bottom: -15%; right: 10%;
    width: 40vw; height: 50vh;
    background: radial-gradient(ellipse, rgba(0,60,180,0.16) 0%, transparent 70%);
  }

  /* ─── Layout ─── */
  .hero__inner {
    position: relative; z-index: 1;
    display: grid;
    grid-template-columns: 55% 1fr;
    gap: clamp(3rem, 6vw, 6rem);
    align-items: center;
    width: 100%;
  }

  /* ─── Contenido ─── */
  .hero__content { display: flex; flex-direction: column; gap: 2rem; }

  .hero__eyebrow {
    display: inline-flex; align-items: center; gap: 0.5rem;
    background: rgba(0,102,204,0.1);
    border: 1px solid rgba(0,102,204,0.28);
    color: rgba(150,200,255,0.9);
    font-size: 0.8125rem; font-weight: 500;
    padding: 0.4rem 1.1rem; border-radius: 100px;
    letter-spacing: 0.02em; width: fit-content;
  }
  .hero__eyebrow-dot {
    width: 7px; height: 7px; background: var(--c-primary);
    border-radius: 50%; animation: pulse 2s ease-in-out infinite; flex-shrink: 0;
  }
  @keyframes pulse { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:.5;transform:scale(.78)} }

  .hero__title {
    font-size: clamp(2.75rem, 5.5vw, 5.5rem);
    font-weight: 800; color: var(--c-ink);
    line-height: 1.04; letter-spacing: -0.035em;
  }
  .hero__title-accent {
    background: linear-gradient(135deg, #60b4ff 0%, #0066cc 55%);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
  }

  .hero__desc {
    font-size: clamp(1rem, 1.3vw, 1.125rem);
    color: var(--c-ink-2); line-height: 1.8;
    max-width: 56ch;
  }

  /* ─── CTAs ─── */
  .hero__ctas { display: flex; gap: 1rem; flex-wrap: wrap; }

  .hero__btn-primary {
    display: inline-flex; align-items: center; gap: 0.5rem;
    background: var(--c-primary); color: #fff;
    padding: 1rem 2rem; border-radius: 8px;
    font-size: 1rem; font-weight: 700;
    box-shadow: 0 4px 24px rgba(0,102,204,0.45);
    transition: background .2s, transform .15s, box-shadow .2s;
  }
  .hero__btn-primary:hover {
    background: var(--c-primary-dark); color: #fff;
    transform: translateY(-2px); box-shadow: 0 8px 32px rgba(0,102,204,0.55);
  }

  .hero__btn-wa {
    display: inline-flex; align-items: center; gap: 0.5rem;
    background: rgba(37,211,102,0.1);
    border: 1.5px solid rgba(37,211,102,0.35);
    color: #25D366;
    padding: 1rem 2rem; border-radius: 8px;
    font-size: 1rem; font-weight: 600;
    transition: background .2s, border-color .2s, transform .15s;
  }
  .hero__btn-wa:hover {
    background: rgba(37,211,102,0.18);
    border-color: rgba(37,211,102,0.6);
    transform: translateY(-1px); color: #25D366;
  }

  /* ─── Trust ─── */
  .hero__trust {
    display: flex; flex-wrap: wrap; gap: 1.5rem;
    padding-top: 1rem; border-top: 1px solid var(--c-border);
  }
  .hero__trust-item {
    display: flex; align-items: center; gap: 0.375rem;
    font-size: 0.875rem; color: var(--c-muted); font-weight: 500;
  }
  .hero__trust-item svg { color: var(--c-primary); flex-shrink: 0; }

  /* ─── Visual LED Panel ─── */
  .hero__visual { display: flex; align-items: center; justify-content: center; }

  .led-panel { position: relative; width: 100%; padding: 24px 0; }

  .led-panel__bezel {
    position: relative;
    background: #070c1a;
    border: 2.5px solid #1c2e52;
    border-radius: 12px;
    padding: 7px;
    box-shadow:
      0 0 0 1px rgba(0,50,120,0.3),
      0 24px 60px rgba(0,0,0,0.75),
      0 0 100px rgba(0,70,200,0.15);
    aspect-ratio: 16/9;
    overflow: visible;
  }

  .led-panel__screen {
    position: relative; width: 100%; height: 100%;
    background: #020508;
    border-radius: 7px; overflow: hidden;
  }

  .led-panel__pixels {
    position: absolute; inset: 0;
    background-image: radial-gradient(circle, rgba(0,120,255,0.5) 1.1px, transparent 1.1px);
    background-size: 5px 5px;
    animation: led-breathe 4s ease-in-out infinite;
  }
  @keyframes led-breathe { 0%,100%{opacity:.5} 50%{opacity:1} }

  .led-panel__scan {
    position: absolute; inset: 0;
    background: linear-gradient(
      180deg,
      transparent 0%,
      rgba(0,120,255,0.07) 48%,
      rgba(0,160,255,0.16) 50%,
      rgba(0,120,255,0.07) 52%,
      transparent 100%
    );
    animation: scan 3.5s linear infinite;
    pointer-events: none;
  }
  @keyframes scan { 0%{transform:translateY(-110%)} 100%{transform:translateY(110%)} }

  .led-panel__content {
    position: absolute; inset: 0;
    display: flex; flex-direction: column;
    align-items: center; justify-content: center; gap: 0.4rem;
    z-index: 2;
  }

  .led-text {
    font-family: 'Courier New', monospace; font-weight: 700;
    color: rgba(0,180,255,0.9); letter-spacing: 0.15em;
    text-shadow: 0 0 12px rgba(0,150,255,0.8), 0 0 24px rgba(0,100,200,0.4);
    line-height: 1;
  }
  .led-text--sm { font-size: clamp(0.5rem, 1vw, 0.7rem); opacity: 0.75; }
  .led-text--lg {
    font-size: clamp(2rem, 5vw, 3.5rem); color: #fff;
    text-shadow: 0 0 20px rgba(0,150,255,1), 0 0 40px rgba(0,100,200,0.7);
    animation: flicker 8s ease-in-out infinite;
  }
  @keyframes flicker { 0%,94%,100%{opacity:1} 95%{opacity:.88} 96%{opacity:1} 97%{opacity:.92} }

  .led-bar {
    width: 70px; height: 3px;
    background: rgba(255,255,255,0.1);
    border-radius: 2px; overflow: hidden; margin-top: 0.3rem;
  }
  .led-bar__fill {
    height: 100%;
    background: linear-gradient(90deg, #0055cc, #00aaff);
    border-radius: 2px;
    animation: bar 2.8s ease-in-out infinite alternate;
  }
  @keyframes bar { from{width:55%} to{width:88%} }

  .led-indicators {
    position: absolute; bottom: 8px; right: 10px;
    display: flex; gap: 5px;
  }
  .led-dot {
    width: 6px; height: 6px; border-radius: 50%;
    animation: blink 2.2s ease-in-out infinite;
  }
  .led-dot--green { background: #22c55e; }
  .led-dot--blue  { background: #3b82f6; animation-delay: .65s; }
  .led-dot--amber { background: #f59e0b; animation-delay: 1.3s; }
  @keyframes blink { 0%,75%,100%{opacity:1} 85%{opacity:.25} }

  .led-panel__glow {
    position: absolute; inset: -24px;
    background: radial-gradient(ellipse at 50% 50%, rgba(0,80,200,0.22) 0%, transparent 65%);
    filter: blur(16px);
    pointer-events: none; z-index: -1; border-radius: 20px;
  }

  /* Specs flotantes */
  .led-spec {
    position: absolute;
    display: flex; flex-direction: column; align-items: center; gap: 3px;
    font-size: 0.6rem; font-weight: 600;
    color: rgba(160,200,255,0.75); text-align: center; letter-spacing: 0.04em;
  }
  .led-spec--tl { top: -2px; left: -4px; }
  .led-spec--tr { top: -2px; right: -4px; }
  .led-spec--bl { bottom: -2px; left: -4px; }
  .led-spec--br { bottom: -2px; right: -4px; }

  .led-spec__badge {
    display: block;
    background: rgba(0,102,204,0.2);
    border: 1px solid rgba(0,102,204,0.4);
    color: rgba(100,180,255,0.95);
    padding: 0.1rem 0.45rem;
    border-radius: 4px; font-size: 0.6rem; font-weight: 700; letter-spacing: 0.06em;
  }

  /* ─── Responsive ─── */
  @media (max-width: 1024px) {
    .hero__inner { grid-template-columns: 1fr; gap: 3.5rem; text-align: center; }
    .hero__eyebrow { margin: 0 auto; }
    .hero__desc { max-width: 100%; }
    .hero__ctas { justify-content: center; }
    .hero__trust { justify-content: center; }
    .hero__visual { max-width: 520px; margin: 0 auto; }
    .led-spec { display: none; }
  }
  @media (max-width: 640px) {
    .hero { min-height: auto; padding-block: 4rem 3rem; }
    .hero__btn-primary, .hero__btn-wa { flex: 1; justify-content: center; }
    .hero__visual { max-width: 360px; }
  }
</style>

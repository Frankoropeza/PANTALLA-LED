---
// ServiciosIndex.astro — Servicios completos de PantallaLED
// Layout 2 columnas: sidebar header + lista numerada

import { url } from '../../utils/url'
import IconCheck from '../ui/icons/IconCheck.astro'
import IconArrowRight from '../ui/icons/IconArrowRight.astro'
import { SERVICIOS } from '../../config/servicios'

const garantias = [
  'Servicio llave en mano',
  'Factura electrónica',
  'Crédito a 30 días',
  'Cotización el mismo día',
]
---

<section class="section section--dark servicios-section" id="servicios" aria-labelledby="servicios-heading">
  <div class="container">
    <div class="split-layout split-layout--narrow servicios-layout">

      <!-- Sidebar header -->
      <div class="split-layout__sidebar servicios-sidebar">
        <p class="sidebar-header__eyebrow">Nuestros servicios</p>
        <h2 id="servicios-heading" class="sidebar-header__title">
          Todo lo que necesitas<br/>para tu <span>pantalla LED</span>
        </h2>
        <p class="sidebar-header__desc">
          Ofrecemos una solución integral: desde la selección del equipo hasta la instalación,
          el contenido y el mantenimiento. Un solo proveedor para todo el ciclo de vida de tu pantalla.
        </p>

        <a href={url('/servicios/')} class="btn btn--primary servicios-cta">
          Ver todos los servicios
        </a>

        <div class="servicios-trust">
          {garantias.map((g) => (
            <div class="servicios-trust__item">
              <IconCheck size={18} strokeWidth={2} />
              <span>{g}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Lista de servicios -->
      <div class="servicios-lista" role="list">
        {SERVICIOS.map((svc) => (
          <article class="svc-item" id={svc.id} role="listitem">
            <span class="svc-item__num" aria-hidden="true">{svc.num}</span>
            <div class="svc-item__body">
              <h3 class="svc-item__title">{svc.title}</h3>
              <p class="svc-item__desc">{svc.desc}</p>
            </div>
            <a href={url(`/servicios/#${svc.id}`)} class="svc-item__link" aria-label={`Ver más sobre ${svc.title}`}>
              <IconArrowRight size={16} />
            </a>
          </article>
        ))}
      </div>

    </div>
  </div>
</section>

<style>
  /* Fondo: .section--dark · Layout: .split-layout--narrow (sistema global) */

  .servicios-cta { margin-bottom: 1.75rem; }

  .servicios-trust {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .servicios-trust__item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--c-muted);
  }
  .servicios-trust__item svg { color: var(--c-primary); flex-shrink: 0; }

  /* ─── Lista ─── */
  .servicios-lista {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .svc-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--c-border);
    transition: background 0.15s;
    position: relative;
  }

  .svc-item:first-child { padding-top: 0; }
  .svc-item:last-child { border-bottom: none; padding-bottom: 0; }

  .svc-item__num {
    font-size: 0.6875rem;
    font-weight: 800;
    color: var(--c-primary);
    letter-spacing: 0.08em;
    flex-shrink: 0;
    margin-top: 0.3rem;
    min-width: 24px;
    opacity: 0.75;
  }

  .svc-item__body { flex: 1; }

  .svc-item__title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--c-ink);
    margin-bottom: 0.375rem;
    line-height: 1.25;
    transition: color 0.15s;
  }
  .svc-item:hover .svc-item__title { color: var(--c-primary); }

  .svc-item__desc {
    font-size: 0.875rem;
    color: var(--c-muted);
    line-height: 1.65;
  }

  .svc-item__link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 1px solid var(--c-border);
    color: var(--c-muted);
    flex-shrink: 0;
    margin-top: 0.25rem;
    transition: border-color 0.15s, color 0.15s, background 0.15s;
  }
  .svc-item:hover .svc-item__link {
    border-color: var(--c-primary);
    color: var(--c-primary);
    background: var(--c-primary-light);
  }

  /* Responsive: el colapso 2-col → 1-col lo maneja .split-layout (sistema global) */
</style>

---
// CategoriasIndex.astro — Grid de tipos de pantallas LED (index L1)
// Datos: config/categorias.ts · Card: ui/CategoryCard.astro
// Grid: .catalogo-grid (components.css)

import SectionHeaderDuo from '../ui/SectionHeaderDuo.astro'
import CategoryCard from '../ui/CategoryCard.astro'
import IconArrowRight from '../ui/icons/IconArrowRight.astro'
import { CATEGORIAS } from '../../config/categorias'
import { url } from '../../utils/url'
---

<section class="section section--dark categorias-section" id="productos" aria-labelledby="categorias-heading">
  <div class="container">

    <SectionHeaderDuo
      id="categorias-heading"
      eyebrow="Catálogo de Productos"
      title="Pantallas LED para <span>cada aplicación</span>"
      desc="Seis líneas de producto que cubren publicidad exterior, interiores premium, eventos y arquitectura creativa."
      body1="Trabajamos con tecnología SMD y COB de última generación en pasos de pixel desde P2 hasta P10: pantallas exteriores IP65 de hasta 10,000 nits para espectaculares y fachadas, e interiores Ultra HD con reproducción de color de nivel broadcast para lobbies, retail y corporativos."
      body2="Como proveedores directos de fábrica eliminamos intermediarios: mejor precio por metro cuadrado, garantía real de 2 años en todos los equipos y stock disponible en México. Cada línea incluye asesoría técnica para elegir la resolución correcta según tu distancia de visión y presupuesto."
    />

    <div class="catalogo-grid categorias-grid">
      {CATEGORIAS.map((cat) => (
        <CategoryCard categoria={cat} />
      ))}
    </div>

    <div class="categorias-footer">
      <a href={url('/productos/')} class="btn btn--outline btn--lg">
        Ver catálogo completo
        <IconArrowRight size={16} />
      </a>
    </div>

  </div>
</section>

<style>
  /* Fondo: .section--dark · Grid: .catalogo-grid · Card: CategoryCard
     (todo del sistema global — aquí solo ajustes de la sección) */

  .categorias-grid { margin-bottom: 3.5rem; }

  .categorias-footer { display: flex; justify-content: center; }
</style>

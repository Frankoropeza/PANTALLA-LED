---
// HeroIndex.astro — Hero principal
// Dos columnas: título grande (izq) · párrafos + CTAs (der)

import { waUrl, WA_MESSAGES } from '../../config/site'
import { url } from '../../utils/url'
---

<section class="hero" aria-labelledby="hero-heading">

  <!-- Fondo decorativo -->
  <div class="hero__bg" aria-hidden="true">
    <div class="hero__grid"></div>
    <div class="hero__glow hero__glow--tl"></div>
    <div class="hero__glow hero__glow--br"></div>
  </div>

  <div class="container hero__inner">

    <!-- ══ Columna 1 — Título ══ -->
    <div class="hero__col hero__col--title">

      <p class="hero__eyebrow">
        <span class="hero__eyebrow-dot" aria-hidden="true"></span>
        Proveedor directo · Sin intermediarios
      </p>

      <h1 id="hero-heading" class="hero__title">
        Pantallas<br/>
        LED de<br/>
        Alta<br/>
        <span class="hero__title-accent">Resolución</span>
      </h1>

      <div class="hero__stats" aria-label="Métricas del negocio">
        <div class="hero__stat">
          <strong class="hero__stat-val">+500</strong>
          <span class="hero__stat-lbl">Instalaciones</span>
        </div>
        <div class="hero__stat-sep" aria-hidden="true"></div>
        <div class="hero__stat">
          <strong class="hero__stat-val">10+</strong>
          <span class="hero__stat-lbl">Años de exp.</span>
        </div>
        <div class="hero__stat-sep" aria-hidden="true"></div>
        <div class="hero__stat">
          <strong class="hero__stat-val">2</strong>
          <span class="hero__stat-lbl">Años garantía</span>
        </div>
      </div>

    </div>

    <!-- Separador vertical -->
    <div class="hero__divider" aria-hidden="true"></div>

    <!-- ══ Columna 2 — Cuerpo ══ -->
    <div class="hero__col hero__col--body">

      <span class="hero__kicker">Para México · Tecnología SMD &amp; COB</span>

      <p class="hero__p">
        Somos proveedores directos de pantallas LED de alta resolución para
        publicidad exterior, interiores y eventos. Equipos IP65 con hasta
        10,000 nits para exteriores e interiores Ultra HD desde P2 — sin
        intermediarios, con cotización gratuita el mismo día en toda la
        República Mexicana.
      </p>

      <p class="hero__p">
        Instalación certificada por técnicos especializados con más de 10 años
        de experiencia. Garantía real de fábrica de 2 años, soporte técnico
        24/7 y respuesta garantizada en menos de 2 horas. Un solo proveedor
        para todo el ciclo de vida de tu pantalla LED.
      </p>

      <div class="hero__ctas">
        <a href={url('/productos/')} class="hero__btn-primary">
          Ver catálogo LED
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
        <a
          href={waUrl(WA_MESSAGES.cotizacion)}
          class="hero__btn-wa"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          Cotizar por WhatsApp
        </a>
      </div>

      <div class="hero__trust">
        <span class="hero__trust-item">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
          Garantía 2 años
        </span>
        <span class="hero__trust-item">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
          Entrega en todo México
        </span>
        <span class="hero__trust-item">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
          Instalación certificada
        </span>
        <span class="hero__trust-item">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
          Soporte 24/7
        </span>
      </div>

    </div>

  </div>
</section>

<style>
  /* ─── Sección ─────────────────────────────────────── */
  .hero {
    position: relative;
    min-height: 88vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    padding-block: clamp(5rem, 8vw, 7rem);
  }

  /* ─── Fondo ─────────────────────────────────────────── */
  .hero__bg { position: absolute; inset: 0; pointer-events: none; }

  .hero__grid {
    position: absolute; inset: 0;
    opacity: 0.035;
    background-image:
      linear-gradient(rgba(0,102,204,1) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0,102,204,1) 1px, transparent 1px);
    background-size: 72px 72px;
  }

  .hero__glow { position: absolute; border-radius: 50%; filter: blur(140px); }
  .hero__glow--tl {
    top: -20%; left: -8%;
    width: 55vw; height: 65vh;
    background: radial-gradient(ellipse, rgba(0,102,204,0.22) 0%, transparent 68%);
  }
  .hero__glow--br {
    bottom: -20%; right: 5%;
    width: 40vw; height: 50vh;
    background: radial-gradient(ellipse, rgba(0,60,180,0.15) 0%, transparent 70%);
  }

  /* ─── Grid principal ─────────────────────────────── */
  .hero__inner {
    position: relative; z-index: 1;
    display: grid;
    grid-template-columns: 1fr 1px 1fr;
    column-gap: clamp(2.5rem, 4.5vw, 4.5rem);
    align-items: center;
    width: 100%;
  }

  /* ─── Separador vertical ──────────────────────────── */
  .hero__divider {
    width: 1px;
    align-self: stretch;
    min-height: 420px;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      var(--c-border) 18%,
      var(--c-border-2) 50%,
      var(--c-border) 82%,
      transparent 100%
    );
  }

  /* ─── Columnas ────────────────────────────────────── */
  .hero__col {
    display: flex;
    flex-direction: column;
  }
  .hero__col--title { gap: 2.25rem; }
  .hero__col--body  { gap: 1.625rem; }

  /* ─── Eyebrow ─────────────────────────────────────── */
  .hero__eyebrow {
    display: inline-flex; align-items: center; gap: 0.5rem;
    background: rgba(0,102,204,0.08);
    border: 1px solid rgba(0,102,204,0.25);
    color: rgba(140,195,255,0.9);
    font-size: 0.8rem; font-weight: 500;
    padding: 0.4rem 1rem; border-radius: 100px;
    letter-spacing: 0.02em; width: fit-content;
  }
  .hero__eyebrow-dot {
    width: 7px; height: 7px; background: var(--c-primary);
    border-radius: 50%; flex-shrink: 0;
    animation: pulse 2.2s ease-in-out infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%       { opacity: .4; transform: scale(.7); }
  }

  /* ─── Título ──────────────────────────────────────── */
  .hero__title {
    font-size: clamp(2.875rem, 5.5vw, 5.5rem);
    font-weight: 800;
    color: var(--c-ink);
    line-height: 1.02;
    letter-spacing: -0.035em;
  }
  .hero__title-accent {
    background: linear-gradient(130deg, #72c6ff 0%, #1a7fe8 45%, #0050b8 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* ─── Stats ───────────────────────────────────────── */
  .hero__stats {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--c-border);
  }
  .hero__stat {
    display: flex; flex-direction: column; gap: 0.2rem;
  }
  .hero__stat-val {
    font-size: clamp(1.375rem, 2vw, 1.75rem);
    font-weight: 800; color: var(--c-ink);
    line-height: 1; letter-spacing: -0.02em;
  }
  .hero__stat-lbl {
    font-size: 0.725rem; color: var(--c-muted);
    font-weight: 500; letter-spacing: 0.025em;
  }
  .hero__stat-sep {
    width: 1px; height: 36px;
    background: var(--c-border); flex-shrink: 0;
  }

  /* ─── Kicker ──────────────────────────────────────── */
  .hero__kicker {
    font-size: 0.75rem; font-weight: 600;
    color: var(--c-primary);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  /* ─── Párrafos ────────────────────────────────────── */
  .hero__p {
    font-size: clamp(0.9375rem, 1.1vw, 1.0625rem);
    color: var(--c-ink-2);
    line-height: 1.85;
  }

  /* ─── CTAs ────────────────────────────────────────── */
  .hero__ctas {
    display: flex; gap: 0.875rem; flex-wrap: wrap;
    padding-top: 0.375rem;
  }

  .hero__btn-primary {
    display: inline-flex; align-items: center; gap: 0.5rem;
    background: var(--c-primary); color: #fff;
    padding: 0.9375rem 1.875rem; border-radius: 8px;
    font-size: 0.9375rem; font-weight: 700;
    box-shadow: 0 4px 20px rgba(0,102,204,0.4);
    transition: background .2s, transform .15s, box-shadow .2s;
    white-space: nowrap;
  }
  .hero__btn-primary:hover {
    background: var(--c-primary-dark); color: #fff;
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(0,102,204,0.5);
  }
  .hero__btn-primary:active { transform: translateY(0); }

  .hero__btn-wa {
    display: inline-flex; align-items: center; gap: 0.5rem;
    background: rgba(37,211,102,0.07);
    border: 1.5px solid rgba(37,211,102,0.28);
    color: #25D366;
    padding: 0.9375rem 1.875rem; border-radius: 8px;
    font-size: 0.9375rem; font-weight: 600;
    transition: background .2s, border-color .2s, transform .15s;
    white-space: nowrap;
  }
  .hero__btn-wa:hover {
    background: rgba(37,211,102,0.14);
    border-color: rgba(37,211,102,0.5);
    color: #25D366;
    transform: translateY(-1px);
  }
  .hero__btn-wa:active { transform: translateY(0); }

  /* ─── Trust ───────────────────────────────────────── */
  .hero__trust {
    display: flex; flex-wrap: wrap; gap: 1.125rem;
    padding-top: 0.25rem;
    border-top: 1px solid rgba(30,45,80,0.6);
  }
  .hero__trust-item {
    display: flex; align-items: center; gap: 0.375rem;
    font-size: 0.8125rem; color: var(--c-muted); font-weight: 500;
  }
  .hero__trust-item svg { color: var(--c-primary); flex-shrink: 0; }

  /* ─── Responsive ──────────────────────────────────── */
  @media (max-width: 1024px) {
    .hero__inner {
      grid-template-columns: 1fr;
      column-gap: 0;
      row-gap: 3rem;
    }
    .hero__divider { display: none; }
    .hero__col--title { align-items: center; text-align: center; }
    .hero__col--body  { align-items: center; text-align: center; }
    .hero__stats      { justify-content: center; }
    .hero__ctas       { justify-content: center; }
    .hero__trust      { justify-content: center; }
    .hero__p          { max-width: 58ch; }
  }

  @media (max-width: 640px) {
    .hero {
      min-height: auto;
      padding-block: 3.5rem 3rem;
    }
    .hero__title { font-size: clamp(2.5rem, 10vw, 3.25rem); }
    .hero__ctas {
      flex-direction: column;
      width: 100%;
      gap: 0.75rem;
    }
    .hero__btn-primary,
    .hero__btn-wa {
      width: 100%;
      justify-content: center;
      padding: 1rem 1.25rem;
    }
    .hero__stats { gap: 1.125rem; }
    .hero__stat-val { font-size: 1.25rem; }
    .hero__p { font-size: 0.9375rem; line-height: 1.8; }
  }

  @media (max-width: 380px) {
    .hero__title { font-size: 2.25rem; }
    .hero__eyebrow { font-size: 0.75rem; padding: 0.35rem 0.85rem; }
  }
</style>
